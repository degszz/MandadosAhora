---
import { SERVICIOS } from "../data/servicios.js";
import "../styles/global.css";
---

<nav>
    <!-- BOTÓN -->
    <a
        id="menu-button"
        class="cursor-pointer text-black lg:hidden"
        aria-controls="navbar-sticky"
        aria-expanded="false"
    >
        <div class="p-2 hover:bg-kai-200 rounded-md dark:hover:bg-kai-900">
            <!-- ICONO MENÚ -->
            <svg
                id="icon-menu"
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="block"
            >
                <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                <path d="M4 8h16"></path>
                <path d="M4 16h16"></path>
            </svg>

            <!-- ICONO CERRAR (X) -->
            <svg
                id="icon-close"
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="hidden"
            >
                <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                <path d="M18 6L6 18"></path>
                <path d="M6 6l12 12"></path>
            </svg>
        </div>
    </a>

    <!-- MENÚ -->
    <div id="menu-open" class="hidden w-full navbar">
        <div
            class="bg-[#F3F5F6] z-[1001] animate-slide-in-bottom animate-duration-medium w-[100vw] md:w-[100vw] h-[calc(100vh-9px)] lg:hidden left-0 top-[320px] flex justify-center px-6 absolute font-medium md:mt-0 pt-4"
        >
            <div
                class="flex flex-col sm:flex-row gap-2 h-full min-w-[85vw] w-full text-start overflow-y-auto pb-6"
            >
                <h3 class="mt-1"><b>Redes:</b></h3>
                <ul class="w-full flex sm:w-1/2 mb-1">

                    <li>
                        <div
                            class="flex pr-5 items-center justify-around max-w-[200px] text-center h-full"
                        >
                            <a
                                href="https://www.facebook.com/profile.php?id=61584653608264"
                                target="_blank"
                                class="hover:scale-110 bg-[#fff] transition-all duration-200 ease-in-out scale-90 shadow-lg font-normal h-10 w-10 items-center justify-center align-center rounded-full outline-none focus:outline-none mr-2 hover:cursor-pointer"
                                type="button"
                            >
                                <div
                                    class="w-full h-full flex items-center justify-center"
                                >
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="24"
                                        height="24"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="#4362AE"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        class="icon icon-tabler icons-tabler-outline icon-tabler-brand-facebook"
                                        ><path
                                            stroke="none"
                                            d="M0 0h24v24H0z"
                                            fill="none"></path><path
                                            d="M7 10v4h3v7h4v-7h3l1 -4h-4v-2a1 1 0 0 1 1 -1h3v-4h-3a5 5 0 0 0 -5 5v2h-3"
                                        ></path></svg
                                    >
                                </div>
                            </a>
                            <a
                                href="https://www.instagram.com/mandadosahora/"
                                target="_blank"
                                class="hover:scale-110 bg-[#fff] transition-all duration-200 ease-in-out scale-90 shadow-lg font-normal h-10 w-10 items-center justify-center rounded-full outline-none focus:outline-none mr-2"
                                type="button"
                            >
                                <div
                                    class="w-full h-full flex items-center justify-center"
                                >
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="24"
                                        height="24"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="#C72785"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        class="icon icon-tabler icons-tabler-outline icon-tabler-brand-instagram"
                                        ><path
                                            stroke="none"
                                            d="M0 0h24v24H0z"
                                            fill="none"></path><path
                                            d="M4 8a4 4 0 0 1 4 -4h8a4 4 0 0 1 4 4v8a4 4 0 0 1 -4 4h-8a4 4 0 0 1 -4 -4z"
                                        ></path><path
                                            d="M9 12a3 3 0 1 0 6 0a3 3 0 0 0 -6 0"
                                        ></path><path d="M16.5 7.5v.01"
                                        ></path></svg
                                    >
                                </div>
                            </a>
                            <a
                                href="https://wa.me/2271415182?text="
                                target="_blank"
                                class="hover:scale-110 bg-[#fff] transition-all duration-200 ease-in-out scale-90 shadow-lg font-normal h-10 w-10 items-center justify-center rounded-full outline-none focus:outline-none mr-2"
                                type="button"
                            >
                                <div
                                    class="w-full h-full flex items-center justify-center"
                                >
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="24"
                                        height="24"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="#1DAA61"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        class="icon icon-tabler icons-tabler-outline icon-tabler-brand-whatsapp"
                                        ><path
                                            stroke="none"
                                            d="M0 0h24v24H0z"
                                            fill="none"></path><path
                                            d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9"
                                        ></path><path
                                            d="M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1"
                                        ></path></svg
                                    >
                                </div>
                            </a>
                        </div>
                    </li>
                </ul>

                <div class="w-full sm:w-1/2 mb-2">
                    <h3 class="mt-2"><b>Servicios:</b></h3>
                    <div class="grid grid-cols-5 sm:grid-cols-5 gap-2 mt-2">
                        {
                            SERVICIOS.map((s, i) => (
                                <button
                                    type="button"
                                    data-service-slug={s.slug}
                                    class="menu-link group relative flex flex-col items-center justify-between
                                           aspect-square
                                           rounded-md border border-white/60
                                           bg-gradient-to-br from-white/95 via-white/80 to-white/60
                                           backdrop-blur-sm shadow-sm
                                           hover:shadow-md hover:scale-[1.08]
                                           active:scale-95
                                           transition-all duration-200 ease-out
                                           animate-fade-in-up cursor-pointer"
                                    style={`animation-delay: ${Math.min(i * 25, 250)}ms; animation-fill-mode: both;`}
                                >
                                    <div
                                        class={`absolute inset-0 rounded-md opacity-15 group-hover:opacity-35 transition-opacity duration-300 ${s.gradient}`}
                                    />
                                    <div class="relative z-10 flex-1 flex items-center justify-center w-full">
                                        <img
                                            src={s.imagen}
                                            alt={s.alt}
                                            loading="lazy"
                                            class="w-[70px] aspect-square object-contain
                                                   transition-transform duration-300 ease-out
                                                   group-hover:scale-110 group-hover:-rotate-6"
                                        />
                                    </div>

                                </button>
                            ))
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</nav>
<div
    id="menu-overlay"
    class="hidden fixed top-[90px] left-0 w-full h-[calc(100vh-90px)] bg-black/40 z-[900]"
>
</div>

<script>
    const button = document.querySelector("#menu-button");
    const menuOpen = document.querySelector("#menu-open");
    const iconMenu = document.querySelector("#icon-menu");
    const iconClose = document.querySelector("#icon-close");
    const overlay = document.querySelector("#menu-overlay");

    function closeMenu() {
        menuOpen.classList.add("hidden");
        overlay.classList.add("hidden");
        iconMenu.classList.remove("hidden");
        iconClose.classList.add("hidden");
    }

    // Abrir / cerrar menú
    button?.addEventListener("click", () => {
        menuOpen.classList.toggle("hidden");
        overlay.classList.toggle("hidden");

        const isOpen = !menuOpen.classList.contains("hidden");
        iconMenu.classList.toggle("hidden", isOpen);
        iconClose.classList.toggle("hidden", !isOpen);
    });

    // Cerrar al hacer clic en un link
    document.querySelectorAll(".menu-link").forEach((link) => {
        link.addEventListener("click", closeMenu);
    });

    // Cerrar al tocar fuera del menú (overlay)
    overlay.addEventListener("click", closeMenu);
</script>
