---
import Menu from "../components/Menu.astro";
const Links = [
    {
        name: "Inicio",
        link: "/",
    },
    {
        name: "Servicios",
        link: "/#servicios",
    },
    {
        name: "Sobre Nosotros",
        link: "#informacion",
    },
];
---

<header
    id="main-header"
    class="z-[1000] fixed top-0 text-white-950 h-[75px] md:h-[75px] w-full flex items-center justify-between"
    style="background:transparent;transition:background .3s ease,backdrop-filter .3s ease,box-shadow .3s ease;"
>
    <div
        class="flex pl-5 lg:min-w-[190px] items-center justify-center w-fit text-center h-full lg:w-[200px]"
    >
        <Menu />
        <div
            class="hidden hover:decoration-[#377DEC] lg:block text-xl text-start w-full font-sans"
        >
            <a
                href="/"
                class="scale-90 duration-200 hover:scale-110 hover:cursor-pointer flex w-full"
            >
                <img src="/logo.avif" class="w-[70px]" alt="" />

            </a>
        </div>
    </div>
    <div class="flex w-full h-full justify-center items-center">
        <div class="hidden md:flex">
            {
                Links.map((link) => (
                    <div class="border-l text-gray-500 hover:text-[#377DEC] border-gray-300/50">
                        <a
                            href={link.link}
                            class="text-start text-lg block  px-3 rounded md:bg-transparent  "
                        >
                            <b>{link.name}</b>
                        </a>
                    </div>
                ))
            }
        </div>
        <div class="flex md:hidden">
            <div
                class="hover:decoration-[#377DEC] text-xl text-start w-full font-sans"
            >
                <a
                    href="/"
                    class="scale-90 duration-200 hover:scale-110 hover:cursor-pointer flex w-full"
                >
                    <img src="/logo.avif" class="w-[70px]" alt="" />
                </a>
            </div>
        </div>
    </div>
    <div class="flex pr-5 items-center justify-around text-center h-full">
        <a
            href="https://www.facebook.com/profile.php?id=61584653608264"
            target="_blank"
            class="hover:scale-110 bg-[#fff] transition-all duration-200 ease-in-out scale-90 shadow-lg font-normal h-10 w-10 items-center justify-center align-center rounded-full outline-none focus:outline-none mr-2 hover:cursor-pointer"
            type="button"
        >
            <div class="w-full h-full flex items-center justify-center">
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="#4362AE"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="icon icon-tabler icons-tabler-outline icon-tabler-brand-facebook"
                    ><path stroke="none" d="M0 0h24v24H0z" fill="none"
                    ></path><path
                        d="M7 10v4h3v7h4v-7h3l1 -4h-4v-2a1 1 0 0 1 1 -1h3v-4h-3a5 5 0 0 0 -5 5v2h-3"
                    ></path></svg
                >
            </div>
        </a>
        <a
            href="https://www.instagram.com/mandadosahora/"
            target="_blank"
            class="hover:scale-110 bg-[#fff] transition-all duration-200 ease-in-out scale-90 shadow-lg font-normal h-10 w-10 items-center justify-center rounded-full outline-none focus:outline-none mr-2"
            type="button"
        >
            <div class="w-full h-full flex items-center justify-center">
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="#C72785"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="icon icon-tabler icons-tabler-outline icon-tabler-brand-instagram"
                    ><path stroke="none" d="M0 0h24v24H0z" fill="none"
                    ></path><path
                        d="M4 8a4 4 0 0 1 4 -4h8a4 4 0 0 1 4 4v8a4 4 0 0 1 -4 4h-8a4 4 0 0 1 -4 -4z"
                    ></path><path d="M9 12a3 3 0 1 0 6 0a3 3 0 0 0 -6 0"
                    ></path><path d="M16.5 7.5v.01"></path></svg
                >
            </div>
        </a>
    </div>
</header>

<script>
  const hdr = document.getElementById('main-header');
  if (hdr) {
    const update = () => {
      if (window.scrollY > 40) {
        hdr.style.background = 'rgba(255,255,255,0.85)';
        hdr.style.backdropFilter = 'blur(14px)';
        hdr.style.webkitBackdropFilter = 'blur(14px)';
        hdr.style.boxShadow = '0 1px 10px rgba(0,0,0,0.06)';
      } else {
        hdr.style.background = 'transparent';
        hdr.style.backdropFilter = 'none';
        hdr.style.webkitBackdropFilter = 'none';
        hdr.style.boxShadow = 'none';
      }
    };
    window.addEventListener('scroll', update, { passive: true });
    update();
  }
</script>
