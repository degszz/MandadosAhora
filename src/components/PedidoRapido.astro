---
// Pedido rápido: una caja en el hero + ventana de 3 pasos.
// Ver docs/notas/Pedido rápido.md
---

<form id="pr-box" class="pr-box" novalidate>
  <label for="pr-texto" class="pr-box-label">¿Qué necesitás?</label>
  <textarea id="pr-texto" rows="2" maxlength="500" placeholder="Ej: 2 cocas y pan lactal del súper"></textarea>
  <p id="pr-box-error" class="pr-error" role="alert" hidden></p>
  <button type="submit" class="pr-primary">Pedir</button>
</form>

<div id="pr-overlay" class="pr-overlay" hidden>
  <div class="pr-sheet" role="dialog" aria-modal="true" aria-labelledby="pr-title">
    <div class="pr-head">
      <div>
        <p id="pr-step-label" class="pr-step-label">Paso 1 de 3</p>
        <h2 id="pr-title">¿Dónde te lo llevamos?</h2>
      </div>
      <button type="button" id="pr-close" class="pr-close" aria-label="Cerrar">×</button>
    </div>
    <div id="pr-progress" class="pr-progress"><span></span></div>

    <!-- Paso 1: dirección -->
    <section data-step="1">
      <button type="button" id="pr-gps" class="pr-gps">📍 Usar mi ubicación</button>
      <div id="pr-gps-ok" class="pr-gps-ok" hidden>
        <span class="pr-check">✓</span>
        <span id="pr-gps-text"></span>
        <button type="button" id="pr-gps-change">Cambiar</button>
      </div>
      <p id="pr-gps-error" class="pr-error" hidden></p>
      <div id="pr-dir-wrap">
        <label for="pr-dir">Calle y número</label>
        <input id="pr-dir" type="text" maxlength="160" autocomplete="street-address" placeholder="Ej: San Martín 450" />
      </div>
    </section>

    <!-- Paso 2: datos y pago -->
    <section data-step="2" hidden>
      <label for="pr-nombre">Tu nombre</label>
      <input id="pr-nombre" type="text" maxlength="80" autocomplete="name" />
      <label for="pr-tel">Teléfono <small>(opcional)</small></label>
      <input id="pr-tel" type="tel" maxlength="30" autocomplete="tel" placeholder="2271 41-5182" />
      <p class="pr-label">¿Cómo pagás?</p>
      <div class="pr-pagos">
        <button type="button" data-pago="efectivo">💵<b>Efectivo</b><small>Al recibir</small></button>
        <button type="button" data-pago="mercadopago">💳<b>MercadoPago</b><small>Ahora</small></button>
      </div>
    </section>

    <!-- Paso 3: confirmar -->
    <section data-step="3" hidden>
      <dl class="pr-resumen">
        <div><dt>Pedido</dt><dd id="pr-r-texto"></dd></div>
        <div><dt>Dirección</dt><dd id="pr-r-dir"></dd></div>
        <div><dt>Pago</dt><dd id="pr-r-pago"></dd></div>
        <div><dt>Servicio</dt><dd id="pr-r-total"></dd></div>
      </dl>
      <p id="pr-nocturno" class="pr-nocturno" hidden>🌙 Estamos fuera de horario: va por el servicio 24 Horas, con tarifa nocturna.</p>
      <p class="pr-nota">Las compras se pagan aparte, según el ticket, más un 15% de comisión al terminar.</p>
    </section>

    <!-- Final -->
    <section data-step="4" hidden>
      <div class="pr-ok">✓</div>
      <p class="pr-code-label">Código de entrega</p>
      <p id="pr-code" class="pr-code"></p>
      <p class="pr-nota pr-center">Dáselo al repartidor solo cuando recibas tu pedido.</p>
      <p id="pr-mp-error" class="pr-error" hidden>No pudimos abrir MercadoPago. Tu pedido quedó guardado: coordiná el pago por WhatsApp.</p>
      <a id="pr-wa" class="pr-wa" target="_blank" rel="noopener">Enviar por WhatsApp</a>
      <a id="pr-mp" class="pr-mp" target="_blank" rel="noopener" hidden>Pagar con MercadoPago</a>
      <a id="pr-track" class="pr-link">Seguir mi pedido</a>
    </section>

    <p id="pr-error" class="pr-error" role="alert" hidden></p>
    <div id="pr-actions" class="pr-actions">
      <button type="button" id="pr-back" class="pr-secondary" hidden>Atrás</button>
      <button type="button" id="pr-next" class="pr-primary">Continuar</button>
    </div>
  </div>
</div>

<style is:global>
  .pr-box { width: 100%; max-width: 28rem; background: #fff; border: 1.5px solid #bfdbfe; border-radius: 1rem; padding: .85rem; box-shadow: 0 10px 28px rgba(37,99,235,.14); text-align: left; display: flex; flex-direction: column; gap: .5rem; }
  .pr-box-label { font-weight: 800; color: #0b0e14; font-size: 1rem; font-family: 'Inter', sans-serif; }
  .pr-box textarea, .pr-sheet input { width: 100%; box-sizing: border-box; border: 1px solid #d1d5db; border-radius: .7rem; padding: .65rem .75rem; font-size: 16px; color: #1f2937; background: #fff; outline: none; }
  .pr-box textarea { resize: none; }
  .pr-box textarea:focus, .pr-sheet input:focus { border-color: #377DEC; box-shadow: 0 0 0 3px rgba(55,125,236,.18); }
  .pr-primary { background: #2563eb; color: #fff; border: 0; border-radius: .75rem; padding: .75rem 1.1rem; font-weight: 700; font-size: .95rem; cursor: pointer; }
  .pr-primary:hover { background: #1d4ed8; }
  .pr-primary:disabled { opacity: .6; cursor: wait; }
  .pr-secondary { background: #fff; color: #4b5563; border: 1px solid #e5e7eb; border-radius: .75rem; padding: .75rem 1.1rem; font-weight: 600; cursor: pointer; }
  .pr-error { color: #991b1b; background: #fef2f2; border: 1px solid #fecaca; border-radius: .55rem; padding: .45rem .65rem; font-size: .8rem; margin: .5rem 0 0; }
  .pr-overlay { position: fixed; inset: 0; z-index: 10000; background: rgba(15,23,42,.5); display: flex; align-items: flex-end; justify-content: center; }
  .pr-overlay[hidden], .pr-sheet [hidden] { display: none !important; }
  .pr-sheet { width: 100%; max-width: 30rem; max-height: 92dvh; overflow-y: auto; box-sizing: border-box; background: #fff; border-radius: 1.25rem 1.25rem 0 0; padding: 1.15rem 1.15rem calc(1.15rem + env(safe-area-inset-bottom)); animation: pr-up .25s ease-out; }
  @media (min-width: 640px) { .pr-overlay { align-items: center; padding: 1rem; } .pr-sheet { border-radius: 1.25rem; } }
  @keyframes pr-up { from { transform: translateY(24px); opacity: 0; } to { transform: none; opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .pr-sheet { animation: none; } }
  .pr-head { display: flex; justify-content: space-between; gap: 1rem; align-items: flex-start; }
  .pr-head h2 { font-size: 1.25rem; font-weight: 800; color: #111827; margin: 0; }
  .pr-step-label { font-size: .72rem; font-weight: 700; color: #2563eb; margin: 0 0 .15rem; }
  .pr-close { background: #f3f4f6; border: 0; border-radius: 9999px; width: 34px; height: 34px; font-size: 1.25rem; color: #4b5563; cursor: pointer; flex-shrink: 0; }
  .pr-progress { height: 4px; background: #e5e7eb; border-radius: 9999px; overflow: hidden; margin: .8rem 0 1rem; }
  .pr-progress span { display: block; height: 100%; width: 33%; background: #2563eb; transition: width .2s; }
  .pr-sheet label, .pr-label { display: block; font-size: .8rem; font-weight: 600; color: #374151; margin: .7rem 0 .3rem; }
  .pr-sheet small { font-weight: 400; color: #6b7280; }
  .pr-gps { width: 100%; background: #2563eb; color: #fff; border: 0; border-radius: .8rem; padding: .85rem; font-weight: 700; cursor: pointer; }
  .pr-gps:disabled { opacity: .65; cursor: wait; }
  @media (min-width: 768px) { .pr-gps { display: none; } }
  .pr-gps-ok { display: flex; align-items: center; gap: .55rem; background: #dcfce7; border: 1px solid #86efac; border-radius: .8rem; padding: .65rem .75rem; font-size: .82rem; color: #166534; }
  .pr-gps-ok span:nth-child(2) { flex: 1; min-width: 0; }
  .pr-gps-ok button { background: none; border: 0; color: #166534; text-decoration: underline; font-size: .75rem; cursor: pointer; }
  .pr-check { width: 24px; height: 24px; border-radius: 50%; background: #22c55e; color: #fff; display: inline-flex; align-items: center; justify-content: center; font-weight: 800; flex-shrink: 0; }
  .pr-pagos { display: grid; grid-template-columns: 1fr 1fr; gap: .55rem; }
  .pr-pagos button { display: flex; flex-direction: column; align-items: center; gap: .1rem; background: #fff; border: 2px solid #e5e7eb; border-radius: .85rem; padding: .75rem .4rem; cursor: pointer; color: #1f2937; font-size: .9rem; }
  .pr-pagos button[aria-pressed="true"] { border-color: #2563eb; background: #eff6ff; }
  .pr-resumen { margin: 0; display: flex; flex-direction: column; gap: .55rem; }
  .pr-resumen div { background: #f9fafb; border-radius: .6rem; padding: .55rem .7rem; }
  .pr-resumen dt { font-size: .7rem; color: #6b7280; }
  .pr-resumen dd { margin: .1rem 0 0; font-size: .88rem; font-weight: 600; color: #1f2937; white-space: pre-wrap; overflow-wrap: anywhere; }
  .pr-nocturno { background: #fffbeb; border: 1px solid #fde68a; color: #92400e; border-radius: .6rem; padding: .55rem .7rem; font-size: .8rem; margin: .6rem 0 0; }
  .pr-nota { font-size: .75rem; color: #6b7280; margin: .6rem 0 0; }
  .pr-center { text-align: center; }
  .pr-actions { display: flex; gap: .5rem; margin-top: 1rem; }
  .pr-actions .pr-primary { flex: 1; }
  .pr-ok { width: 52px; height: 52px; margin: 0 auto .6rem; border-radius: 50%; background: #22c55e; color: #fff; font-size: 1.6rem; font-weight: 800; display: flex; align-items: center; justify-content: center; }
  .pr-code-label { text-align: center; font-size: .75rem; color: #6b7280; margin: 0; }
  .pr-code { text-align: center; font-family: ui-monospace, monospace; font-size: 2rem; font-weight: 800; letter-spacing: .18em; color: #111827; background: #fef9c3; border-radius: .75rem; padding: .35rem; margin: .25rem 0 0; }
  .pr-wa, .pr-mp { display: block; text-align: center; text-decoration: none; color: #fff; font-weight: 700; border-radius: .8rem; padding: .85rem; margin-top: .7rem; }
  .pr-wa { background: #16a34a; }
  .pr-mp { background: #0284c7; }
  .pr-link { display: block; text-align: center; color: #2563eb; font-size: .85rem; font-weight: 600; margin-top: .75rem; }
</style>

<script>
  import { createOrder } from "../scripts/orders.js";
  import { createMPPreference } from "../scripts/mercadopago.js";
  import { geolocate, reverseGeocode } from "../scripts/gmaps.js";
  import { getProfile, setProfile } from "../scripts/profile.js";
  import { fetchBusinessStatus, isOfflineNow } from "../scripts/business.js";
  import { whatsappOrderUrl } from "../scripts/whatsapp.js";

  const FEE_NORMAL = 2500;
  const FEE_NOCTURNO = 3500;
  const TITULOS = { 1: "¿Dónde te lo llevamos?", 2: "Tus datos y pago", 3: "Confirmá tu pedido", 4: "¡Pedido recibido!" };

  const $ = (id) => document.getElementById(id);
  const overlay = $("pr-overlay");
  // Fuera del hero: sus animaciones romperían el position:fixed
  document.body.appendChild(overlay);

  const state = { step: 1, gps: null, pago: null, offline: false, saving: false, lastFocus: null };
  const ars = (n) => "$" + Number(n).toLocaleString("es-AR");
  const fee = () => (state.offline ? FEE_NOCTURNO : FEE_NORMAL);

  function setMsg(el, msg) {
    el.textContent = msg || "";
    el.hidden = !msg;
  }

  function direccion() {
    if (state.gps) return { tipo: "mapa", ...state.gps };
    const texto = $("pr-dir").value.trim();
    return texto ? { tipo: "manual", texto, address: texto } : null;
  }

  function pintarGps() {
    $("pr-gps-ok").hidden = !state.gps;
    $("pr-gps").hidden = !!state.gps;
    $("pr-dir-wrap").hidden = !!state.gps;
    $("pr-gps-text").textContent = state.gps?.address || "";
  }

  function irA(step) {
    state.step = step;
    document.querySelectorAll(".pr-sheet [data-step]").forEach((s) => { s.hidden = Number(s.dataset.step) !== step; });
    $("pr-title").textContent = TITULOS[step];
    $("pr-step-label").textContent = step <= 3 ? `Paso ${step} de 3` : "Listo";
    $("pr-progress").firstElementChild.style.width = `${Math.min(step, 3) * 33.34}%`;
    $("pr-back").hidden = step === 1 || step === 4;
    $("pr-actions").hidden = step === 4;
    $("pr-next").textContent = step === 3 ? "Confirmar pedido" : "Continuar";
    setMsg($("pr-error"), "");
    if (step === 3) pintarResumen();
    $("pr-title").closest(".pr-sheet").scrollTop = 0;
  }

  function pintarResumen() {
    $("pr-r-texto").textContent = $("pr-texto").value.trim();
    const d = direccion();
    $("pr-r-dir").textContent = d?.address || "";
    $("pr-r-pago").textContent = state.pago === "mercadopago" ? "MercadoPago" : "Efectivo al recibir";
    $("pr-r-total").textContent = ars(fee());
    $("pr-nocturno").hidden = !state.offline;
  }

  async function abrir() {
    const texto = $("pr-texto").value.trim();
    if (texto.length < 3) {
      setMsg($("pr-box-error"), "Contanos qué necesitás.");
      $("pr-texto").focus();
      return;
    }
    setMsg($("pr-box-error"), "");
    state.lastFocus = document.activeElement;

    const p = getProfile();
    if (!$("pr-nombre").value) $("pr-nombre").value = p.nombre || "";
    if (!$("pr-tel").value) $("pr-tel").value = p.telefono || "";
    if (!state.gps && !$("pr-dir").value && p.direccion) {
      if (p.direccion.tipo === "mapa" && p.direccion.lat != null) {
        state.gps = { address: p.direccion.address, lat: p.direccion.lat, lng: p.direccion.lng };
      } else {
        $("pr-dir").value = p.direccion.texto || p.direccion.address || "";
      }
    }
    pintarGps();
    state.offline = isOfflineNow();
    irA(1);
    overlay.hidden = false;
    document.body.style.overflow = "hidden";
    $("pr-close").focus();

    // Precio con el estado real, antes de llegar a confirmar
    const s = await fetchBusinessStatus();
    if (s.ok) {
      state.offline = !s.online;
      if (state.step === 3) pintarResumen();
    }
  }

  function cerrar() {
    if (state.saving) return;
    const terminado = state.step === 4;
    overlay.hidden = true;
    document.body.style.overflow = "";
    if (terminado) {
      $("pr-texto").value = "";
      state.pago = null;
      document.querySelectorAll("[data-pago]").forEach((b) => b.setAttribute("aria-pressed", "false"));
      irA(1);
    }
    state.lastFocus?.focus?.();
  }

  function validar() {
    if (state.step === 1 && !direccion()) return "Compartí tu ubicación o escribí la dirección.";
    if (state.step === 2 && !$("pr-nombre").value.trim()) return "Decinos tu nombre.";
    if (state.step === 2 && !state.pago) return "Elegí cómo pagás.";
    return "";
  }

  async function confirmar() {
    if (state.saving) return;
    state.saving = true;
    const btn = $("pr-next");
    btn.disabled = true;
    $("pr-back").disabled = true;
    btn.textContent = "Guardando...";

    const nombre = $("pr-nombre").value.trim();
    const telefono = $("pr-tel").value.trim();
    const d = direccion();
    const total = fee();
    const deliveryCode = String(Math.floor(100000 + Math.random() * 900000));
    const servicios = [{
      servicio: state.offline ? "24 Horas" : "Pedido rápido",
      descripcion: $("pr-texto").value.trim(),
      cantidad: 1,
    }];

    try {
      const order = await createOrder({
        nombre,
        telefono,
        servicios,
        ubicacion: { tipo: d.tipo, direccion: d.address, numero: "", lat: d.lat ?? null, lng: d.lng ?? null },
        pago: { metodo: state.pago, monto: total },
        deliveryCode,
        driverCommission: total,
      });
      setProfile({ nombre, telefono, direccion: d });

      let paymentUrl = null;
      setMsg($("pr-mp-error"), "");
      if (state.pago === "mercadopago") {
        btn.textContent = "Conectando con MercadoPago...";
        try {
          paymentUrl = (await createMPPreference({ orderId: order.id, amount: total, description: "Mandados Ahora — Pedido rápido" })).paymentUrl || null;
        } catch (e) {
          console.warn("[pedido-rapido] MercadoPago:", e?.message);
        }
        if (!paymentUrl) setMsg($("pr-mp-error"), "No pudimos abrir MercadoPago. Tu pedido quedó guardado: coordiná el pago por WhatsApp.");
      }

      $("pr-code").textContent = deliveryCode;
      $("pr-wa").href = whatsappOrderUrl({ orderId: order.id, nombre, telefono, servicios, direccion: d, total, metodo: state.pago, paymentUrl, deliveryCode });
      $("pr-mp").hidden = !paymentUrl;
      if (paymentUrl) $("pr-mp").href = paymentUrl;
      $("pr-track").href = `/pedido?id=${order.id}`;
      irA(4);
    } catch (e) {
      console.error("[pedido-rapido]", e);
      btn.textContent = "Confirmar pedido";
      setMsg($("pr-error"), "No se pudo guardar el pedido. Revisá tu conexión y probá de nuevo.");
    } finally {
      state.saving = false;
      btn.disabled = false;
      $("pr-back").disabled = false;
    }
  }

  $("pr-box").addEventListener("submit", (e) => { e.preventDefault(); abrir(); });
  $("pr-texto").addEventListener("input", () => setMsg($("pr-box-error"), ""));
  $("pr-close").addEventListener("click", cerrar);
  overlay.addEventListener("click", (e) => { if (e.target === overlay) cerrar(); });
  document.addEventListener("keydown", (e) => { if (e.key === "Escape" && !overlay.hidden) cerrar(); });
  $("pr-back").addEventListener("click", () => irA(state.step - 1));
  $("pr-next").addEventListener("click", () => {
    const err = validar();
    if (err) return setMsg($("pr-error"), err);
    if (state.step === 3) confirmar();
    else irA(state.step + 1);
  });

  document.querySelectorAll("[data-pago]").forEach((b) => {
    b.setAttribute("aria-pressed", "false");
    b.addEventListener("click", () => {
      state.pago = b.dataset.pago;
      document.querySelectorAll("[data-pago]").forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
      setMsg($("pr-error"), "");
    });
  });

  $("pr-gps").addEventListener("click", async () => {
    const b = $("pr-gps");
    b.disabled = true;
    b.textContent = "Buscando tu ubicación...";
    setMsg($("pr-gps-error"), "");
    try {
      const { lat, lng } = await geolocate();
      state.gps = { lat, lng, address: await reverseGeocode(lat, lng) };
      pintarGps();
    } catch (e) {
      setMsg($("pr-gps-error"), `${e.message}. Activá la ubicación en tu celular o escribí la dirección.`);
    } finally {
      b.disabled = false;
      b.textContent = "📍 Usar mi ubicación";
    }
  });

  $("pr-gps-change").addEventListener("click", () => {
    state.gps = null;
    pintarGps();
    $("pr-dir").focus();
  });
</script>
