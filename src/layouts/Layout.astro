---
const { title } = Astro.props;
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.avif" />
		<meta name="generator" content={Astro.generator} />
		<title>Mandados Ahora</title>
		<meta name="description" content="Mandados Ahora - Servicio de mandados y entregas rápidas las 24 horas del día, los 7 días de la semana. ¡Tu solución confiable para todas tus necesidades de entrega!" />
		<meta name="keywords" content="Mandados, Entregas Rápidas, Servicio de Mandados, Entregas 24 Horas, Entregas a Domicilio, Servicio de Entrega, Mandados Ahora, Entregas Urgentes, Entregas Locales, Entregas en Ciudad, Servicio de Mensajería, Entregas Express, Entregas Seguras, Entregas Confiables" />
		<meta name="author" content="Mandados Ahora" />
		<meta name="robots" content="index, follow" />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Poppins:wght@600;700;800&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body
		class="h-full from-[#f4f6f7] bg-gradient-to-b via-[#e4e7e9] to-[#616d79]"
	>
		<Header />
		<main class="mt-[90px] md:mt-[90px]">
			<slot />
		</main>
		<Footer />
	</body>
</html>
