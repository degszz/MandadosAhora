---
import Layout from "../../layouts/Layout.astro";
import "../../styles/global.css";
---

<Layout title="Soy repartidor · Mandados Ahora">
  <div class="w-full flex justify-center my-8 px-4">
    <div class="w-full max-w-lg">
      <a
        href="/"
        class="inline-flex items-center gap-1 text-sm text-gray-600 hover:text-[#377DEC] mb-4 transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12l14 0"/><path d="M5 12l6 6"/><path d="M5 12l6 -6"/>
        </svg>
        Volver al inicio
      </a>

      <!-- Hero repartidor -->
      <div style="background:linear-gradient(135deg,#2563eb 0%,#3b82f6 50%,#60a5fa 100%);border-radius:1.25rem;padding:2rem 1.5rem;margin-bottom:1.25rem;text-align:center;color:#fff;position:relative;overflow:hidden">
        <div style="position:absolute;top:-30px;right:-30px;width:120px;height:120px;border-radius:50%;background:rgba(255,255,255,0.08)"></div>
        <div style="position:absolute;bottom:-20px;left:-20px;width:80px;height:80px;border-radius:50%;background:rgba(255,255,255,0.06)"></div>
        <div style="font-size:2.5rem;margin-bottom:0.5rem">🛵</div>
        <h1 style="font-size:1.5rem;font-weight:800;margin:0 0 0.35rem;font-family:'Poppins',sans-serif">Unite al equipo</h1>
        <p style="font-size:0.88rem;opacity:0.9;margin:0;line-height:1.5">
          Repartí mandados en San Miguel del Monte y generá ingresos con tu vehículo.
        </p>
      </div>

      <!-- Cómo funciona -->
      <div style="background:#fff;border-radius:1rem;border:1px solid #e5e7eb;padding:1.25rem;margin-bottom:1rem">
        <h2 style="font-size:1rem;font-weight:700;color:#1f2937;margin:0 0 0.85rem;display:flex;align-items:center;gap:0.4rem">
          <span style="font-size:1.1rem">📋</span> Cómo funciona
        </h2>
        <div style="display:flex;flex-direction:column;gap:0.65rem">
          <div style="display:flex;gap:0.65rem;align-items:flex-start">
            <span style="min-width:28px;height:28px;border-radius:50%;background:#EBF3FF;color:#2563eb;font-size:0.75rem;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0">1</span>
            <div>
              <p style="font-size:0.85rem;font-weight:600;color:#1f2937;margin:0">Registrate con Google</p>
              <p style="font-size:0.75rem;color:#6b7280;margin:0.15rem 0 0">Usá tu cuenta real con nombre y foto. Así los clientes saben quién entrega su pedido.</p>
            </div>
          </div>
          <div style="display:flex;gap:0.65rem;align-items:flex-start">
            <span style="min-width:28px;height:28px;border-radius:50%;background:#EBF3FF;color:#2563eb;font-size:0.75rem;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0">2</span>
            <div>
              <p style="font-size:0.85rem;font-weight:600;color:#1f2937;margin:0">El admin te verifica</p>
              <p style="font-size:0.75rem;color:#6b7280;margin:0.15rem 0 0">Revisamos tu perfil para garantizar seguridad a los clientes.</p>
            </div>
          </div>
          <div style="display:flex;gap:0.65rem;align-items:flex-start">
            <span style="min-width:28px;height:28px;border-radius:50%;background:#EBF3FF;color:#2563eb;font-size:0.75rem;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0">3</span>
            <div>
              <p style="font-size:0.85rem;font-weight:600;color:#1f2937;margin:0">Recibí pedidos y entregá</p>
              <p style="font-size:0.75rem;color:#6b7280;margin:0.15rem 0 0">Tomá los pedidos disponibles, navegá al destino con Google Maps y confirmá la entrega con el código del cliente.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Cuánto ganás -->
      <div style="background:#fff;border-radius:1rem;border:1px solid #e5e7eb;padding:1.25rem;margin-bottom:1rem">
        <h2 style="font-size:1rem;font-weight:700;color:#1f2937;margin:0 0 0.85rem;display:flex;align-items:center;gap:0.4rem">
          <span style="font-size:1.1rem">💰</span> Cuánto ganás
        </h2>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.65rem">
          <div style="background:linear-gradient(135deg,#f0fdf4,#dcfce7);border:1.5px solid #bbf7d0;border-radius:0.875rem;padding:1rem;text-align:center">
            <div style="font-size:1.5rem;font-weight:800;color:#166534;font-family:'Poppins',sans-serif">$2.000</div>
            <div style="font-size:0.72rem;color:#15803d;font-weight:600;margin-top:0.2rem">por servicio</div>
            <div style="font-size:0.65rem;color:#6b7280;margin-top:0.15rem">Horario laboral</div>
          </div>
          <div style="background:linear-gradient(135deg,#fefce8,#fef9c3);border:1.5px solid #fde68a;border-radius:0.875rem;padding:1rem;text-align:center">
            <div style="font-size:1.5rem;font-weight:800;color:#92400e;font-family:'Poppins',sans-serif">$3.500</div>
            <div style="font-size:0.72rem;color:#a16207;font-weight:600;margin-top:0.2rem">por servicio</div>
            <div style="font-size:0.65rem;color:#6b7280;margin-top:0.15rem">24hs fuera de horario</div>
          </div>
        </div>
        <p style="font-size:0.72rem;color:#9ca3af;margin:0.6rem 0 0;text-align:center">
          El pago se acredita por cada entrega completada.
        </p>
      </div>

      <!-- Seguridad -->
      <div style="background:#fffbeb;border-radius:1rem;border:1.5px solid #fde68a;padding:1rem 1.15rem;margin-bottom:1.25rem;display:flex;gap:0.7rem;align-items:flex-start">
        <span style="font-size:1.3rem;flex-shrink:0;margin-top:1px">🔒</span>
        <div>
          <p style="font-size:0.82rem;font-weight:700;color:#92400e;margin:0">Tu identidad importa</p>
          <p style="font-size:0.75rem;color:#78350f;margin:0.2rem 0 0;line-height:1.45">
            Al registrarte con Google, tu <b>nombre real y foto de perfil</b> quedan vinculados a tu cuenta.
            Los clientes ven quién entrega su pedido — esto genera confianza y seguridad para todos.
          </p>
        </div>
      </div>

      <!-- Login con Google -->
      <div style="background:#fff;border-radius:1rem;border:1px solid #e5e7eb;padding:1.5rem;box-shadow:0 4px 16px rgba(0,0,0,0.06)">
        <h2 style="font-size:1.05rem;font-weight:700;color:#1f2937;margin:0 0 0.25rem;text-align:center">Empezá ahora</h2>
        <p style="font-size:0.78rem;color:#6b7280;margin:0 0 1rem;text-align:center">
          Usá tu cuenta de Google con tu nombre y foto reales.
        </p>

        <button
          id="google-btn"
          type="button"
          style="width:100%;display:flex;align-items:center;justify-content:center;gap:0.65rem;background:#fff;border:1.5px solid #d1d5db;border-radius:0.875rem;padding:0.85rem 1rem;font-weight:600;color:#374151;cursor:pointer;transition:all .2s;font-size:0.95rem;font-family:'Inter',sans-serif"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 48 48">
            <path fill="#FFC107" d="M43.611 20.083H42V20H24v8h11.303c-1.649 4.657-6.08 8-11.303 8c-6.627 0-12-5.373-12-12s5.373-12 12-12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4C12.955 4 4 12.955 4 24s8.955 20 20 20s20-8.955 20-20c0-1.341-.138-2.65-.389-3.917z"/>
            <path fill="#FF3D00" d="m6.306 14.691l6.571 4.819C14.655 15.108 18.961 12 24 12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4C16.318 4 9.656 8.337 6.306 14.691z"/>
            <path fill="#4CAF50" d="M24 44c5.166 0 9.86-1.977 13.409-5.192l-6.19-5.238C29.211 35.091 26.715 36 24 36c-5.202 0-9.619-3.317-11.283-7.946l-6.522 5.025C9.505 39.556 16.227 44 24 44z"/>
            <path fill="#1976D2" d="M43.611 20.083H42V20H24v8h11.303a12.04 12.04 0 0 1-4.087 5.571l.003-.002l6.19 5.238C36.971 39.205 44 34 44 24c0-1.341-.138-2.65-.389-3.917z"/>
          </svg>
          <span id="google-btn-label">Iniciar sesión con Google</span>
        </button>

        <p id="rep-err" class="hidden text-sm text-red-700 bg-red-50 border border-red-200 rounded-lg px-3 py-2 mt-3" role="alert"></p>

        <div style="margin-top:1rem;background:#EBF3FF;border-radius:0.75rem;padding:0.7rem 0.85rem;display:flex;align-items:center;gap:0.5rem">
          <span style="font-size:0.9rem;flex-shrink:0">⏳</span>
          <p style="font-size:0.75rem;color:#1e40af;margin:0;line-height:1.35">
            Después de registrarte, tu cuenta queda <b>pendiente de verificación</b> por el admin.
          </p>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { getSupabase, signInWithGoogle, getMyProfile } from "../../scripts/supabase.js";

  const btn = document.getElementById("google-btn");
  const lbl = document.getElementById("google-btn-label");
  const err = document.getElementById("rep-err");

  // Si ya hay sesión, redirigir directo según el rol
  (async () => {
    const sb = getSupabase();
    if (!sb) return;
    const { data: { session } } = await sb.auth.getSession();
    if (!session) return;
    const profile = await getMyProfile();
    if (profile?.role === "admin") {
      window.location.replace("/admin");
    } else if (profile?.role === "repartidor" && !profile.verified) {
      window.location.replace("/repartidor/espera");
    } else if (profile?.role === "repartidor" && profile.verified) {
      window.location.replace("/repartidor/panel");
    }
  })();

  btn?.addEventListener("click", async () => {
    err.classList.add("hidden");
    btn.disabled = true;
    btn.style.opacity = "0.6";
    lbl.textContent = "Redirigiendo...";
    try {
      await signInWithGoogle("/repartidor/panel");
    } catch (e) {
      err.textContent = "⚠️ " + (e?.message || "No se pudo iniciar sesión");
      err.classList.remove("hidden");
      btn.disabled = false;
      btn.style.opacity = "1";
      lbl.textContent = "Iniciar sesión con Google";
    }
  });
</script>
