---
import Layout from "../../layouts/Layout.astro";
import { useEffect } from "astro/jsx-runtime";
---

<Layout title="mas">
  <div class="w-full flex justify-center my-8">
    <form
      id="waForm"
      class="bg-white shadow-lg rounded-2xl p-6 w-full max-w-md space-y-5 border border-gray-100"
      client:load
    >
      <h2
        class="text-2xl font-semibold text-gray-800 text-start mb-1 underline"
      >
        Mas de un Servicio
      </h2>
      <span class="text-md text-[#377DEC] mb-1"
        ><b>Costo: 10% del Monto + $2000 ARS</b></span
      >

      <!-- Nombre -->
      <div>
        <label class="block text-sm font-medium text-gray-600 mb-1"
          >Nombre</label
        >
        <input
          type="text"
          id="nombre"
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 outline-none"
        />
      </div>

      <!-- Contacto -->
      <div>
        <label class="block text-sm font-medium text-gray-600 mb-1"
          >Local o Sucursal</label
        >
        <input
          type="text"
          placeholder=""
          id="contacto"
          required
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 outline-none"
        />
      </div>

      <!-- Direccion -->
      <div>
        <label class="block text-sm font-medium text-gray-600 mb-1"
          >Direccion</label
        >
        <input
          type="text"
          id="direccion"
          placeholder="Belgrano 123"
          required
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 outline-none"
        />
      </div>

      <!-- Detalles -->
      <div >
        <label class="block text-sm font-medium text-gray-600 mb-1">
          Detalles del pedido
        </label>
        <textarea
          id="detalles"
          rows="4"
          required
          placeholder="Escribe aqui lo que Necesites"
          class="w-full px-4 py-2 border border-gray-300 rounded-lg resize-none focus:ring-2 focus:ring-green-500 focus:border-green-500 outline-none"
        ></textarea>
      </div>

      <!-- Contenedor dinámico -->
      <div id="extraFields"></div>

      <button
        type="button"
        id="addFieldBtn"
        class="w-full border-2 text-black p-2 mb-4 rounded-lg font-medium transition"
      >
        + Agregar otro local
      </button>

      <!-- Métodos de pago -->
      <div>
        <p class="text-sm font-medium text-gray-700 mb-2">Método de pago</p>

        <label class="flex items-center gap-2 cursor-pointer mb-1">
          <input type="radio" name="pago" value="Mercado Pago" required />
          <span class="text-gray-700">Mercado Pago</span>
        </label>

        <label class="flex items-center gap-2 cursor-pointer">
          <input type="radio" name="pago" value="Efectivo" required />
          <span class="text-gray-700">Efectivo</span>
        </label>
      </div>

      <!-- Botón -->
      <button
        type="submit"
        class="w-full h-fit border-2 hover:ring-[#377DEC] text-black p-2 rounded-lg font-medium transition"
      >
        Enviar por WhatsApp
      </button>
    </form>
  </div>
</Layout>
<script client:load>
  let counter = 1;

  document.getElementById("addFieldBtn").addEventListener("click", () => {
    counter++;

    const container = document.getElementById("extraFields");

    const block = document.createElement("div");
    block.className =
      "mt-4 p-4 border border-gray-200 rounded-xl space-y-3 bg-gray-50 relative";
    block.innerHTML = `
      <h3 class="font-semibold text-gray-700 underline">Local adicional #${counter}</h3>

      <div>
        <label class="block text-sm font-medium text-gray-600 mb-1">Local o Sucursal</label>
        <input type="text" class="extra-contacto w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500" />
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-600 mb-1">Detalles</label>
        <textarea rows="3" class="extra-detalles w-full px-4 py-2 border border-gray-300 rounded-lg resize-none focus:ring-2 focus:ring-green-500"></textarea>
      </div>

      <button type="button"
        class="remove-btn bg-red-500 text-white px-3 py-1 rounded-lg text-sm">
        Eliminar
      </button>
    `;

    // Botón eliminar
    block.querySelector(".remove-btn").addEventListener("click", () => {
      block.remove();
    });

    container.appendChild(block);
  });

  document.getElementById("waForm").addEventListener("submit", function (e) {
    e.preventDefault();

    const nombre = document.getElementById("nombre").value;
    const contacto = document.getElementById("contacto").value;
    const direccion = document.getElementById("direccion").value;
    const detalles = document.getElementById("detalles").value;
    const pago = document.querySelector("input[name='pago']:checked").value;

    let mensaje = `
*Libreria*
👤 Nombre: ${nombre}

🏬 Local 1: ${contacto}
📍 Dirección: ${direccion}
📝 Detalles:
${detalles}
`;

    // Campos adicionales
    const extraContactos = document.querySelectorAll(".extra-contacto");
    const extraDetalles = document.querySelectorAll(".extra-detalles");

    extraContactos.forEach((_, i) => {
      mensaje += `
------------------------------
🏬 Local ${i + 2}: ${extraContactos[i].value}
📝 Detalles:
${extraDetalles[i].value}
`;
    });

    mensaje += `

💳 Método de pago: ${pago}
💲 Precio del Servicio: 10% del Monto + $2000 ARS
`;

    const url =
      "https://wa.me/2271415182?text=" + encodeURIComponent(mensaje);
    window.open(url, "_blank");
  });
</script>

