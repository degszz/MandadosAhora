---
import Layout from "../../layouts/Layout.astro";
import { SERVICIOS } from "../../data/servicios.js";
import { INITIAL_LAT, INITIAL_LNG } from "../../scripts/gmaps.js";

export function getStaticPaths() {
  return SERVICIOS.map((s) => ({
    params: { slug: s.slug },
    props: { servicio: s },
  }));
}

const { servicio } = Astro.props;
const titulo = servicio.titulo ?? servicio.servicio;
---

<Layout>
  <div class="w-full flex justify-center my-8 px-4">
    <div
      class="w-full max-w-md flex flex-col items-center"
      data-initial-lat={INITIAL_LAT}
      data-initial-lng={INITIAL_LNG}
      id="servicio-root"
    >
      <a
        href="/#servicios"
        class="self-start mb-4 text-sm text-gray-600 hover:text-[#377DEC] flex items-center gap-1 transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12l14 0"/>
          <path d="M5 12l6 6"/>
          <path d="M5 12l6 -6"/>
        </svg>
        Volver a servicios
      </a>

      <div class="w-full flex flex-col items-center group animate-fade-in-up animate-duration-slow">
        <div
          class={`relative z-10 min-h-[180px] min-w-[180px] w-full max-w-[260px] overflow-hidden p-2 border rounded-2xl m-2 shadow-lg ${servicio.gradient}`}
        >
          <img
            src={servicio.imagen}
            class="absolute -rotate-6 left-1/2 -translate-x-1/2 size-44 md:size-52 z-20 transition-transform group-hover:scale-105 group-hover:-rotate-12"
            alt={servicio.alt}
          />
        </div>
        <h1 class="text-3xl font-bold text-gray-800 text-center mt-2">
          {titulo}
        </h1>
      </div>

      <form
        id="servicio-form"
        class="w-full bg-white shadow-lg rounded-2xl p-6 mt-6 space-y-4 border border-gray-100 animate-fade-in-up animate-duration-slow animate-delay-200"
        style="animation-fill-mode: both;"
        data-servicio={servicio.servicio}
        data-slug={servicio.slug}
        data-imagen={servicio.imagen}
        data-alt={servicio.alt || servicio.servicio}
      >
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5" for="nombre">
            Nombre
          </label>
          <input
            id="nombre"
            type="text"
            placeholder="Tu nombre (opcional)"
            class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#377DEC] focus:border-[#377DEC] outline-none"
          />
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5" for="negocio">
            Sucursal o local
          </label>
          <input
            id="negocio"
            type="text"
            placeholder="¿De qué local o sucursal? (ej: Supermercado Día, Farmacia del Centro)"
            class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#377DEC] focus:border-[#377DEC] outline-none"
          />
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5" for="desc">
            Descripción del pedido
          </label>
          <textarea
            id="desc"
            rows="4"
            placeholder="Describí qué necesitás (ej: 2 cocas de 2.25L, pan lactal)"
            class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#377DEC] focus:border-[#377DEC] outline-none resize-none"
          ></textarea>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5">
            Dirección de entrega
          </label>

          <!-- Estado: sin ubicación -->
          <div id="loc-empty" style="display:flex;flex-direction:column;gap:0.6rem">
            <!-- GPS: solo visible en celular -->
            <div class="loc-mobile-only">
              <button
                type="button"
                id="geo-btn"
                style="width:100%;background:linear-gradient(135deg,#377DEC 0%,#5b9bf5 100%);color:#fff;border:none;border-radius:0.875rem;padding:1rem;font-size:0.95rem;font-weight:600;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:0.6rem;box-shadow:0 4px 12px rgba(55,125,236,0.3);transition:all 0.2s"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 2v2"/><path d="M12 20v2"/><path d="M2 12h2"/><path d="M20 12h2"/>
                  <circle cx="12" cy="12" r="4"/><circle cx="12" cy="12" r="9"/>
                </svg>
                Compartir mi ubicación
              </button>
              <div style="display:flex;align-items:center;gap:0.5rem;padding:0.35rem 0.25rem 0">
                <div style="flex:1;height:1px;background:#e5e7eb"></div>
                <span style="font-size:0.75rem;color:#9ca3af;font-weight:500">o escribila</span>
                <div style="flex:1;height:1px;background:#e5e7eb"></div>
              </div>
            </div>
            <input
              id="dir-manual"
              type="text"
              placeholder="Calle y número (ej: San Martín 450)"
              class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#377DEC] focus:border-[#377DEC] outline-none"
            />
            <p class="loc-mobile-only" style="font-size:0.72rem;color:#9ca3af;margin:0;padding:0 0.1rem;display:flex;align-items:center;gap:0.3rem">
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
              Activá la ubicación en tu celular para compartirla.
            </p>
          </div>

          <!-- Estado: obteniendo GPS (mobile) -->
          <div id="loc-loading" style="display:none">
            <div class="loc-loading-box" style="background:linear-gradient(135deg,#EBF3FF,#dbeafe);border:1.5px solid #93c5fd;border-radius:1rem;padding:1.5rem;text-align:center">
              <div class="loc-pulse-ring" style="width:48px;height:48px;margin:0 auto 0.75rem;position:relative">
                <div style="position:absolute;inset:0;border-radius:50%;border:3px solid #bfd7ff;border-top-color:#377DEC;animation:spin 0.8s linear infinite"></div>
                <div style="position:absolute;inset:-6px;border-radius:50%;border:2px solid transparent;border-top-color:rgba(55,125,236,0.2);animation:spin 1.4s linear infinite reverse"></div>
              </div>
              <p style="font-size:0.9rem;color:#1e40af;font-weight:600;margin:0">Buscando tu ubicación...</p>
              <p style="font-size:0.72rem;color:#6b7280;margin:0.35rem 0 0">Aceptá el permiso si el navegador lo pide.</p>
            </div>
          </div>

          <!-- Estado: ubicación obtenida -->
          <div id="loc-result" style="display:none;flex-direction:column;gap:0.5rem">
            <div class="loc-check-bar" style="background:#dcfce7;border:1.5px solid #86efac;border-radius:0.875rem;padding:0.7rem 0.85rem;display:flex;align-items:center;gap:0.6rem;animation:loc-slide-in .4s ease-out">
              <span class="loc-check-icon" style="width:28px;height:28px;border-radius:50%;background:#22c55e;display:flex;align-items:center;justify-content:center;flex-shrink:0;animation:loc-check-pop .5s cubic-bezier(.175,.885,.32,1.275) .15s both">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5l10 -10"/></svg>
              </span>
              <div>
                <span style="font-size:0.85rem;font-weight:700;color:#166534;display:block">Ubicación marcada</span>
                <span style="font-size:0.7rem;color:#15803d;opacity:0.85">Tu repartidor podrá navegar directo</span>
              </div>
            </div>
            <div
              id="map-container"
              style="width:100%;height:180px;border-radius:0.875rem;border:1.5px solid #e5e7eb;overflow:hidden;background:#f3f4f6;animation:loc-slide-in .4s ease-out .1s both"
            ></div>
            <div id="map-address" style="background:#EBF3FF;border-radius:0.6rem;padding:0.6rem 0.75rem;display:flex;align-items:flex-start;gap:0.5rem;animation:loc-slide-in .4s ease-out .2s both">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#377DEC" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;margin-top:1px"><path d="M9 11a3 3 0 1 0 6 0a3 3 0 0 0 -6 0"/><path d="M17.657 16.657l-4.243 4.243a2 2 0 0 1 -2.827 0l-4.244 -4.243a8 8 0 1 1 11.314 0z"/></svg>
              <span id="map-address-text" style="font-size:0.82rem;color:#1e40af;line-height:1.3">—</span>
            </div>
            <div style="display:flex;gap:0.4rem;animation:loc-slide-in .4s ease-out .3s both">
              <a id="maps-link" href="#" target="_blank" rel="noopener" style="flex:1;display:flex;align-items:center;justify-content:center;gap:0.35rem;font-size:0.75rem;color:#377DEC;font-weight:500;padding:0.5rem;border:1px solid #bfd7ff;border-radius:0.6rem;text-decoration:none;background:#fff">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6l-12 12"/><path d="M8 6h10v10"/></svg>
                Ver en Google Maps
              </a>
              <button type="button" id="loc-change" style="flex:1;font-size:0.75rem;color:#6b7280;font-weight:500;padding:0.5rem;border:1px solid #e5e7eb;border-radius:0.6rem;background:#fff;cursor:pointer">
                Cambiar ubicación
              </button>
            </div>
            <p class="loc-mobile-only" style="font-size:0.68rem;color:#9ca3af;margin:0;text-align:center">
              Podés mover el pin en el mapa para ajustar tu punto exacto.
            </p>
          </div>

          <!-- Estado: error de GPS -->
          <div id="loc-error" style="display:none;flex-direction:column;gap:0.5rem">
            <div class="loc-error-shake" style="background:#fef2f2;border:1.5px solid #fecaca;border-radius:0.875rem;padding:0.85rem;display:flex;align-items:flex-start;gap:0.6rem;animation:loc-shake .5s ease-out">
              <span style="width:32px;height:32px;border-radius:50%;background:#fee2e2;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:1rem">📍</span>
              <div>
                <p id="loc-error-msg" style="font-size:0.85rem;font-weight:700;color:#991b1b;margin:0">Ubicación no disponible</p>
                <p style="font-size:0.75rem;color:#7f1d1d;margin:0.3rem 0 0;line-height:1.4">Activá la ubicación en tu celular:</p>
                <div style="margin-top:0.4rem;background:#fff;border-radius:0.5rem;padding:0.5rem 0.6rem;border:1px solid #fecaca">
                  <p style="font-size:0.72rem;color:#374151;margin:0;line-height:1.5">
                    <b>Android:</b> Ajustes → Ubicación → Activar<br/>
                    <b>iPhone:</b> Configuración → Privacidad → Ubicación
                  </p>
                </div>
              </div>
            </div>
            <button type="button" id="loc-retry" style="width:100%;background:linear-gradient(135deg,#377DEC,#5b9bf5);color:#fff;border:none;border-radius:0.75rem;padding:0.75rem;font-size:0.85rem;font-weight:600;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:0.4rem;box-shadow:0 2px 8px rgba(55,125,236,0.25)">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 11a8.1 8.1 0 0 0 -15.5 -2m-.5 -4v4h4"/><path d="M4 13a8.1 8.1 0 0 0 15.5 2m.5 4v-4h-4"/></svg>
              Reintentar
            </button>
            <div style="display:flex;align-items:center;gap:0.5rem;padding:0 0.25rem">
              <div style="flex:1;height:1px;background:#e5e7eb"></div>
              <span style="font-size:0.75rem;color:#9ca3af;font-weight:500">o escribila</span>
              <div style="flex:1;height:1px;background:#e5e7eb"></div>
            </div>
            <input
              id="dir-manual-fallback"
              type="text"
              placeholder="Calle y número (ej: San Martín 450)"
              class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#377DEC] focus:border-[#377DEC] outline-none"
            />
          </div>
        </div>

        <p
          id="form-error"
          class="text-sm text-red-700 bg-red-50 border border-red-200 rounded-lg px-3 py-2"
          role="alert"
          style="display:none"
        ></p>

        <button
          type="submit"
          id="add-btn"
          class="w-full bg-black  text-white rounded-xl py-3 transition-all duration-150 hover:shadow-lg disabled:opacity-50 flex items-center justify-center gap-2 shadow-md"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 19m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0"/>
            <path d="M17 19m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0"/>
            <path d="M17 17h-11v-14h-2"/>
            <path d="M6 5l14 1l-1 7h-13"/>
            <path d="M19 7v6"/>
            <path d="M16 10h6"/>
          </svg>
          Agregar al carrito
        </button>

        <p id="feedback" class="hidden text-center text-sm text-green-600 font-medium"></p>
      </form>

      <a
        href="/#servicios"
        class="mt-4 text-sm text-gray-500 hover:text-[#377DEC] underline transition-colors"
      >
        Agregar otro servicio
      </a>
    </div>
  </div>
</Layout>

<style>
  /* GPS solo visible en celular */
  @media (min-width: 768px) {
    .loc-mobile-only { display: none !important; }
  }
  /* Animaciones de ubicación */
  @keyframes loc-slide-in {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes loc-check-pop {
    0%   { transform: scale(0); }
    70%  { transform: scale(1.25); }
    100% { transform: scale(1); }
  }
  @keyframes loc-shake {
    0%, 100% { transform: translateX(0); }
    15%  { transform: translateX(-6px); }
    30%  { transform: translateX(5px); }
    45%  { transform: translateX(-4px); }
    60%  { transform: translateX(3px); }
    75%  { transform: translateX(-1px); }
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
</style>

<script>
  import { addItem } from "../../scripts/cart.js";
  import { getProfile, setProfile } from "../../scripts/profile.js";
  import {
    loadLeaflet,
    createMap,
    reverseGeocode,
    geolocate,
    mapsLink,
  } from "../../scripts/gmaps.js";

  const root = document.getElementById("servicio-root");
  const INITIAL_LAT = parseFloat(root.dataset.initialLat);
  const INITIAL_LNG = parseFloat(root.dataset.initialLng);

  const form = document.getElementById("servicio-form");
  const nombreEl = document.getElementById("nombre");
  const negEl = document.getElementById("negocio");
  const descEl = document.getElementById("desc");
  const dirManualEl = document.getElementById("dir-manual");
  const btn = document.getElementById("add-btn");
  const feedback = document.getElementById("feedback");
  const errorEl = document.getElementById("form-error");

  // Location UI sections
  const locEmpty = document.getElementById("loc-empty");
  const locLoading = document.getElementById("loc-loading");
  const locResult = document.getElementById("loc-result");
  const locError = document.getElementById("loc-error");
  const mapContainer = document.getElementById("map-container");
  const mapAddressText = document.getElementById("map-address-text");
  const mapsLinkEl = document.getElementById("maps-link");

  const state = {
    locMode: "empty", // "empty" | "loading" | "result" | "error"
    map: null,
    marker: null,
    mapLat: null,
    mapLng: null,
    mapAddress: "",
  };

  // ----- Autocompletar desde profile -----
  const profile = getProfile();
  if (profile.nombre) nombreEl.value = profile.nombre;
  if (profile.direccion) {
    if (profile.direccion.tipo === "manual" && profile.direccion.texto) {
      dirManualEl.value = profile.direccion.texto;
    } else if (profile.direccion.tipo === "mapa" && profile.direccion.lat != null) {
      // Restaurar ubicación previa automáticamente
      showLocationResult(profile.direccion.lat, profile.direccion.lng, profile.direccion.address);
    }
  }

  // ----- Location state machine -----
  function setLocState(s) {
    state.locMode = s;
    locEmpty.style.display = s === "empty" ? "flex" : "none";
    locLoading.style.display = s === "loading" ? "block" : "none";
    locResult.style.display = s === "result" ? "flex" : "none";
    locError.style.display = s === "error" ? "flex" : "none";
  }

  async function requestLocation() {
    setLocState("loading");
    try {
      const { lat, lng } = await geolocate();
      const address = await reverseGeocode(lat, lng);
      showLocationResult(lat, lng, address);
    } catch (err) {
      const msgEl = document.getElementById("loc-error-msg");
      if (msgEl) msgEl.textContent = err.message || "No se pudo obtener tu ubicación";
      setLocState("error");
    }
  }

  async function showLocationResult(lat, lng, address) {
    state.mapLat = lat;
    state.mapLng = lng;
    state.mapAddress = address || `${lat.toFixed(6)}, ${lng.toFixed(6)}`;
    mapAddressText.textContent = state.mapAddress;
    mapsLinkEl.href = mapsLink(lat, lng);
    setLocState("result");

    // Render map
    try {
      await loadLeaflet();
      mapContainer.innerHTML = "";
      const { map, marker } = createMap(mapContainer, { lat, lng, zoom: 17 });
      state.map = map;
      state.marker = marker;
      marker.on("dragend", onPinMove);
      map.on("click", (e) => {
        marker.setLatLng(e.latlng);
        onPinMove();
      });
      // Force map resize after layout settles
      setTimeout(() => map.invalidateSize(), 100);
    } catch {
      mapContainer.innerHTML = '<div style="display:flex;align-items:center;justify-content:center;height:100%;color:#6b7280;font-size:0.8rem">Mapa no disponible</div>';
    }
  }

  async function onPinMove() {
    const { lat, lng } = state.marker.getLatLng();
    state.mapLat = lat;
    state.mapLng = lng;
    state.mapAddress = await reverseGeocode(lat, lng);
    mapAddressText.textContent = state.mapAddress;
    mapsLinkEl.href = mapsLink(lat, lng);
  }

  // ----- Event listeners -----
  document.getElementById("geo-btn")?.addEventListener("click", requestLocation);
  document.getElementById("loc-retry")?.addEventListener("click", requestLocation);
  document.getElementById("loc-change")?.addEventListener("click", () => {
    state.mapLat = null;
    state.mapLng = null;
    state.mapAddress = "";
    if (state.map) { try { state.map.remove(); } catch {} state.map = null; }
    setLocState("empty");
  });

  // ----- Submit -----
  function getDireccion() {
    // GPS location has priority
    if (state.locMode === "result" && state.mapLat != null && state.mapLng != null) {
      return {
        tipo: "mapa",
        address: state.mapAddress || `${state.mapLat.toFixed(6)}, ${state.mapLng.toFixed(6)}`,
        lat: state.mapLat,
        lng: state.mapLng,
      };
    }
    // Manual input (from empty or error state)
    const manualEl = state.locMode === "error"
      ? document.getElementById("dir-manual-fallback")
      : dirManualEl;
    const texto = manualEl?.value?.trim();
    if (texto) return { tipo: "manual", texto, address: texto };
    return null;
  }

  function showError(msg, focusEl) {
    errorEl.textContent = `⚠️ ${msg}`;
    errorEl.style.display = "block";
    if (focusEl) {
      focusEl.style.borderColor = "#ef4444";
      focusEl.scrollIntoView({ behavior: "smooth", block: "center" });
      setTimeout(() => focusEl.focus(), 250);
      setTimeout(() => { focusEl.style.borderColor = ""; }, 2400);
    }
  }

  function clearError() {
    errorEl.style.display = "none";
    errorEl.textContent = "";
  }

  // Limpiar el error apenas el usuario empieza a escribir
  [nombreEl, negEl, descEl, dirManualEl].forEach((el) => {
    el?.addEventListener("input", clearError);
  });

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    clearError();

    const servicio = form.dataset.servicio;
    const nombre = nombreEl.value.trim();
    const negocio = negEl.value.trim();
    const descripcion = descEl.value.trim();

    if (!descripcion && !negocio) {
      showError("Completá al menos la descripción del pedido o la sucursal.", descEl);
      return;
    }

    const direccion = getDireccion();
    if (!direccion) {
      showError("Compartí tu ubicación o escribí la dirección de entrega.", dirManualEl);
      return;
    }

    addItem({
      servicio,
      slug: form.dataset.slug || "",
      imagen: form.dataset.imagen || "",
      alt: form.dataset.alt || servicio,
      nombre,
      negocio,
      descripcion,
      direccion,
    });
    setProfile({ nombre, direccion });

    // Reset (mantenemos nombre y dirección)
    negEl.value = "";
    descEl.value = "";

    feedback.textContent = "✓ Agregado al carrito";
    feedback.classList.remove("hidden");

    btn.disabled = true;
    const originalText = btn.textContent;
    btn.textContent = "✓ Agregado";
    btn.style.background = "#22c55e";

    setTimeout(() => {
      btn.disabled = false;
      btn.textContent = originalText;
      btn.style.background = "";
      feedback.classList.add("hidden");
    }, 1800);
  });
</script>
