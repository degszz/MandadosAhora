---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
---

<Layout title="Pago exitoso — Mandados Ahora">
  <div class="w-full flex justify-center my-8 px-4">
    <div id="pago-root" class="w-full max-w-lg min-h-[300px] flex items-center justify-center">
      <div style="text-align:center;color:#6b7280">Verificando pago...</div>
    </div>
  </div>
</Layout>

<script>
  const root = document.getElementById("pago-root");
  const params = new URLSearchParams(window.location.search);
  const provider = params.get("provider") || "";
  const orderId = params.get("order_id") || "";
  const status = params.get("status") || "";

  // Si el pago fue pendiente (MP puede devolver eso)
  const isPending = status === "pending";

  const trackLink = orderId
    ? `<a href="/pedido?id=${orderId}" style="display:inline-block;background:#377DEC;color:#fff;padding:0.7rem 1.75rem;border-radius:0.6rem;font-weight:600;text-decoration:none;font-size:0.95rem">
         📍 Seguir mi pedido en vivo
       </a>`
    : "";

  const providerLabel = provider === "stripe" ? "Stripe" : provider === "mercadopago" ? "MercadoPago" : "tu medio de pago";

  if (isPending) {
    root.innerHTML = `
      <div style="background:#fff;border-radius:1rem;padding:2rem 1.5rem;width:100%;text-align:center;box-shadow:0 10px 25px -5px rgba(0,0,0,0.08);border:1px solid #e5e7eb">
        <div style="width:56px;height:56px;border-radius:50%;background:#fef3c7;display:flex;align-items:center;justify-content:center;margin:0 auto 1rem;font-size:1.75rem">⏳</div>
        <h2 style="font-size:1.35rem;font-weight:700;color:#1f2937;margin-bottom:0.25rem">Pago pendiente</h2>
        <p style="color:#6b7280;font-size:0.875rem;margin-bottom:1.25rem">
          Tu pago con ${providerLabel} está siendo procesado. Te notificaremos cuando se confirme.
        </p>
        ${trackLink}
        <br>
        <a href="/" style="display:inline-block;color:#6b7280;padding:0.5rem 1.5rem;font-size:0.85rem;text-decoration:underline;margin-top:0.5rem">
          Volver al inicio
        </a>
      </div>
    `;
  } else {
    root.innerHTML = `
      <div style="background:#fff;border-radius:1rem;padding:2rem 1.5rem;width:100%;text-align:center;box-shadow:0 10px 25px -5px rgba(0,0,0,0.08);border:1px solid #e5e7eb">
        <svg xmlns="http://www.w3.org/2000/svg" width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin:0 auto 0.75rem;display:block">
          <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
          <path d="M5 12l5 5l10 -10"/>
        </svg>
        <h2 style="font-size:1.35rem;font-weight:700;color:#1f2937;margin-bottom:0.25rem">¡Pago recibido!</h2>
        <p style="color:#6b7280;font-size:0.875rem;margin-bottom:0.5rem">
          Tu pago de <b style="color:#1f2937">$3.000</b> con ${providerLabel} fue procesado correctamente.
        </p>
        <p style="color:#6b7280;font-size:0.8rem;margin-bottom:1.25rem">
          Tu pedido ya está en camino. Podés seguir el estado en tiempo real.
        </p>
        ${trackLink}
        <br>
        <a href="/" style="display:inline-block;color:#6b7280;padding:0.5rem 1.5rem;font-size:0.85rem;text-decoration:underline;margin-top:0.5rem">
          Volver al inicio
        </a>
      </div>
    `;
  }
</script>
