<script define:vars={{ SUPABASE_URL: import.meta.env.PUBLIC_SUPABASE_URL, SUPABASE_ANON_KEY: import.meta.env.PUBLIC_SUPABASE_ANON_KEY }}>
  // ── Business status: online/offline badge + service cards + 24HS banner ──
  (async () => {
    if (!SUPABASE_URL || !SUPABASE_ANON_KEY) return;

    const hdrs = {
      "apikey": SUPABASE_ANON_KEY,
      "Authorization": "Bearer " + SUPABASE_ANON_KEY,
      "Accept-Profile": "mandados",
    };

    const DAY_MAP = ["sunday","monday","tuesday","wednesday","thursday","friday","saturday"];

    // ── Determinar si el negocio está online ──
    function isBusinessOnline(businessOpen, schedule) {
      // Toggle manual desactivado → offline
      if (businessOpen === false) return false;
      // Sin schedule → online (solo toggle manual)
      if (!schedule) return true;
      const now = new Date();
      const dayKey = DAY_MAP[now.getDay()];
      const daySchedule = schedule[dayKey];
      // Día sin horario (null) → offline
      if (!daySchedule) return false;
      const [oh, om] = (daySchedule.open || "00:00").split(":").map(Number);
      const [ch, cm] = (daySchedule.close || "23:59").split(":").map(Number);
      const mins = now.getHours() * 60 + now.getMinutes();
      return mins >= (oh * 60 + om) && mins <= (ch * 60 + cm);
    }

    // ── Actualizar badge del hero ──
    function updateHeroBadge(online) {
      const text = document.getElementById("hero-status-text");
      const dotSolid = document.getElementById("hero-dot-solid");
      const dotPing = document.getElementById("hero-dot-ping");
      const badge = document.getElementById("hero-status-badge");
      if (!text || !dotSolid || !dotPing || !badge) return;

      if (online) {
        text.textContent = "San Miguel del Monte · Online";
        dotSolid.style.background = "#22c55e";
        dotPing.style.background = "#22c55e";
        dotPing.classList.add("animate-ping");
        badge.style.borderColor = "rgba(134,239,172,0.6)";
      } else {
        text.textContent = "San Miguel del Monte · Offline";
        dotSolid.style.background = "#ef4444";
        dotPing.style.background = "#ef4444";
        dotPing.classList.remove("animate-ping");
        badge.style.borderColor = "rgba(252,165,165,0.5)";
      }
    }

    // ── Mostrar/ocultar banner 24HS ──
    function update24hBanner(online) {
      const banner = document.getElementById("offline-24h-banner");
      if (banner) banner.style.display = online ? "none" : "block";
    }

    // ── Aplicar schedules por servicio a las cards ──
    function applyServiceCards(schedules, businessOnline) {
      const cards = document.querySelectorAll(".svc-card[data-service-slug]");
      const schedMap = {};
      schedules.forEach(function(s) { schedMap[s.service_slug] = s; });

      cards.forEach(function(card) {
        var slug = card.dataset.serviceSlug;
        card.querySelector(".svc-closed-overlay")?.remove();
        card.querySelectorAll(".svc-open-badge").forEach(function(b) { b.remove(); });
        card.classList.remove("svc-closed", "svc-24h-open");
        card.style.borderColor = "";
        card.style.background = "";

        // 24 Horas: siempre activo
        if (slug === "24horas") {
          card.classList.add("svc-24h-open");
          var isOffHours = !businessOnline;
          var badge24 = document.createElement("span");
          badge24.className = "svc-open-badge";
          badge24.style.cssText = "position:absolute;top:8px;right:8px;background:" + (isOffHours ? "#d97706" : "#16a34a") + ";color:#fff;font-size:0.6rem;font-weight:700;padding:0.15rem 0.45rem;border-radius:9999px;z-index:20;pointer-events:none";
          badge24.textContent = isOffHours ? "Disponible · $3.500" : "Abierto 24hs";
          card.appendChild(badge24);
          if (isOffHours) {
            card.style.borderColor = "#fde68a";
            card.style.background = "linear-gradient(135deg, #fffbeb, #fff)";
          }
          return;
        }

        // Si el negocio está offline → todos cerrados (excepto 24hs)
        if (!businessOnline) {
          card.classList.add("svc-closed");
          var ov = document.createElement("div");
          ov.className = "svc-closed-overlay";
          ov.style.cssText = "position:absolute;inset:0;background:rgba(255,255,255,0.82);border-radius:1rem;flex-direction:column;align-items:center;justify-content:center;z-index:15;backdrop-filter:blur(1px)";
          ov.innerHTML = '<span style="font-size:1.5rem;margin-bottom:0.25rem">🔒</span><span style="font-size:0.7rem;font-weight:700;color:#4b5563;text-transform:uppercase;letter-spacing:0.08em">Cerrado</span>';
          card.style.position = "relative";
          card.appendChild(ov);
          return;
        }

        // Negocio online: verificar schedule individual del servicio
        var sched = schedMap[slug];
        if (!sched) return;

        var now = new Date();
        var todayName = DAY_MAP[now.getDay()];
        var currentMinutes = now.getHours() * 60 + now.getMinutes();

        var svcOpen = true;
        if (!sched.is_open) svcOpen = false;
        else {
          var days = Array.isArray(sched.days_open) ? sched.days_open : [];
          if (!days.includes(todayName)) svcOpen = false;
          else {
            var parts1 = (sched.open_time || "00:00").split(":").map(Number);
            var parts2 = (sched.close_time || "23:59").split(":").map(Number);
            if (currentMinutes < parts1[0] * 60 + parts1[1] || currentMinutes > parts2[0] * 60 + parts2[1]) svcOpen = false;
          }
        }

        if (!svcOpen) {
          card.classList.add("svc-closed");
          var ov2 = document.createElement("div");
          ov2.className = "svc-closed-overlay";
          ov2.style.cssText = "position:absolute;inset:0;background:rgba(255,255,255,0.82);border-radius:1rem;flex-direction:column;align-items:center;justify-content:center;z-index:15;backdrop-filter:blur(1px)";
          ov2.innerHTML = '<span style="font-size:1.5rem;margin-bottom:0.25rem">🔒</span><span style="font-size:0.7rem;font-weight:700;color:#4b5563;text-transform:uppercase;letter-spacing:0.08em">Cerrado</span><span style="font-size:0.62rem;color:#9ca3af;margin-top:0.15rem">' + (sched.open_time?.slice(0,5)||"") + "–" + (sched.close_time?.slice(0,5)||"") + '</span>';
          card.style.position = "relative";
          card.appendChild(ov2);
        }
      });
    }

    // ── Fetch y aplicar todo ──
    async function fetchAndApply() {
      try {
        var [settingsRes, schedsRes] = await Promise.all([
          fetch(SUPABASE_URL + "/rest/v1/settings?key=in.(business_open,business_schedule)&select=key,value", { headers: hdrs }),
          fetch(SUPABASE_URL + "/rest/v1/schedules?select=*", { headers: hdrs }),
        ]);
        var settings = settingsRes.ok ? await settingsRes.json() : [];
        var schedules = schedsRes.ok ? await schedsRes.json() : [];

        var businessOpen = true;
        var businessSchedule = null;
        settings.forEach(function(s) {
          if (s.key === "business_open") businessOpen = s.value;
          if (s.key === "business_schedule") businessSchedule = s.value;
        });

        var online = isBusinessOnline(businessOpen, businessSchedule);
        updateHeroBadge(online);
        update24hBanner(online);
        applyServiceCards(schedules, online);
      } catch (e) {
        console.warn("[business-status]", e);
        // Default: show as online
        updateHeroBadge(true);
      }
    }

    await fetchAndApply();

    // Re-fetch cada 2 min
    setInterval(fetchAndApply, 2 * 60 * 1000);
  })();
</script>
