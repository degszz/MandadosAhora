    animation: hero-card-float 2.5s ease-in-out infinite alternate;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  /* Timings individuales para flotar natural */
  .orbit-fi-0 { animation-duration: 2.4s; animation-delay: 0s;   }
  .orbit-fi-1 { animation-duration: 2.9s; animation-delay: 0.5s; }
  .orbit-fi-2 { animation-duration: 2.2s; animation-delay: 1.1s; }
  .orbit-fi-3 { animation-duration: 3.1s; animation-delay: 0.3s; }
  .orbit-fi-4 { animation-duration: 2.7s; animation-delay: 0.8s; }

  /* ── Card visual ── */
