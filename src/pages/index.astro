				<!-- Nuestra Misión -->
				<article class="bento-card group relative overflow-hidden rounded-2xl p-4 bg-gradient-to-br from-rose-50 via-pink-100/60 to-orange-100 border border-rose-200/60 shadow-md flex flex-col sm:col-span-2 lg:col-span-2 sm:max-h-[150px] transition-all duration-300 ease-out hover:-translate-y-1 hover:shadow-xl hover:border-rose-300">
					<div class="absolute -top-10 -left-10 w-36 h-36 rounded-full bg-rose-300/40 blur-2xl pointer-events-none transition-transform duration-700 group-hover:scale-125"></div>
					<div class="relative flex items-center gap-2 mb-2">
						<div class="shrink-0 w-10 h-10 rounded-xl bg-gradient-to-br from-rose-500 to-orange-500 text-white text-lg flex items-center justify-center shadow-md shadow-rose-500/30 transition-transform duration-300 group-hover:scale-110 group-hover:rotate-12">
							⭐
						</div>
						<h3 class="text-lg font-extrabold text-rose-900">Nuestra Misión</h3>
					</div>
					<p class="relative text-gray-700 text-sm overflow-y-auto pr-1 leading-relaxed">
						Brindar un servicio de mandados que facilite la vida diaria de nuestros clientes, ofreciendo <b>rapidez, confianza y atención humana</b>. Buscamos apoyar a los comercios locales y ser una solución accesible y segura para todos los vecinos de San Miguel del Monte.
					</p>
				</article>
			</div>
