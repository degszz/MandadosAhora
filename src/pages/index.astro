---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
import Carouselchill from "../components/Carouselchill.astro";
import AudioRecorder from "../components/AudioRecorder.jsx";
import ServiceCard from "../components/ServiceCard.astro";
import { SERVICIOS } from "../data/servicios.js";

const ORBITAL_SLUGS = ["mercado", "farmacia", "carniceria", "panaderia", "verduleria"];
const ORBITAL = ORBITAL_SLUGS
  .map((slug) => SERVICIOS.find((s) => s.slug === slug))
  .filter(Boolean);
---

<Layout>
	<body class="h-full w-full flex flex-col justify-center items-center">
		<section
			class="hero-section relative w-full overflow-hidden  px-4 py-1 md:py-16 lg:py-20 "
		>
			<div
				class="max-w-6xl mx-auto grid md:grid-cols-2 gap-10 md:gap-8 items-center"
			>
				<!-- Columna izquierda -->
				<div class="flex flex-col items-start gap-2 md:gap-6">
					<span
						class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-sky-100/70 backdrop-blur border border-sky-200/80 text-sky-900 text-xs sm:text-sm font-medium animate-fade-in-down animate-duration-slow"
					>
						<span class="relative inline-flex w-2 h-2">
							<span
								class="absolute inset-0 rounded-full bg-green-500"
							></span>
							<span
								class="absolute inset-0 rounded-full bg-green-500 animate-ping opacity-75"
							></span>
						</span>
						San Miguel del Monte · Online ahora
					</span>

					<h1
						class="text-3xl md:text-6xl lg:text-7xl font-extrabold leading-[1.05] tracking-tight animate-fade-in-up animate-delay-200 animate-duration-slow"
						style="font-family: 'Inter', system-ui, sans-serif;"
					>
						<span class="block text-[#0b0e14]"
							>Pedí lo que necesites,</span
						>
						<span class="block text-[#2563eb]">te lo llevamos.</span>
					</h1>

					<p
						class="text-base md:text-lg text-gray-600 max-w-md animate-fade-in-up animate-delay-400 animate-duration-slow"
					>
						Súper, farmacia, carnicería y mucho más. Hacé tu mandado
						desde casa y te lo llevamos a la puerta.
						<b class="text-gray-800">Sin vueltas.</b>
					</p>

					<div
						class="flex sm:flex-row w-full max-w-md animate-fade-in-up animate-delay-600 animate-duration-slow"
					>
						<a
							href="#servicios"
							class="inline-flex items-center justify-center gap-2 bg-[#2563eb] hover:bg-[#1d4ed8] text-white font-semibold px-3 mx-1 py-2 rounded-xl shadow-lg shadow-blue-500/30 transition-all duration-200 hover:scale-[1.02] active:scale-95"
						>
							<svg
								xmlns="http://www.w3.org/2000/svg"
								width="18"
								height="18"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2.5"
								stroke-linecap="round"
								stroke-linejoin="round"
							>
								<path d="M12 5v14"></path>
								<path d="M5 12h14"></path>
							</svg>
							Empezar pedido
						</a>
						<a
							href="https://wa.me/2271415182"
							target="_blank"
							rel="noopener"
							class="inline-flex items-center justify-center gap-2 bg-white hover:bg-gray-50 border border-gray-300 text-gray-800 font-semibold px-3 py-2 rounded-xl shadow transition-all duration-200 hover:scale-[1.02] active:scale-95"
						>
							<svg
								xmlns="http://www.w3.org/2000/svg"
								width="18"
								height="18"
								viewBox="0 0 24 24"
								fill="none"
								stroke="#25D366"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
							>
								<path
									stroke="none"
									d="M0 0h24v24H0z"
									fill="none"></path>
								<path
									d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9"
								></path>
								<path
									d="M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1"
								></path>
							</svg>
							WhatsApp
						</a>
					</div>

					<div
						class="grid grid-cols-3 gap-3 md:gap-6  w-full max-w-md animate-fade-in-up animate-delay-800 animate-duration-slow"
					>
						<div>
							<div
								class="text-2xl md:text-3xl font-extrabold text-[#2563eb]"
							>
								30 min
							</div>
							<div class="text-xs md:text-sm text-gray-500">
								Entrega promedio
							</div>
						</div>
						<div>
							<div
								class="text-2xl md:text-3xl font-extrabold text-[#2563eb]"
							>
								14
							</div>
							<div class="text-xs md:text-sm text-gray-500">
								Rubros
							</div>
						</div>
						<div>
							<div
								class="text-2xl md:text-3xl font-extrabold text-[#2563eb]"
							>
								4.9★
							</div>
							<div class="text-xs md:text-sm text-gray-500">
								Calificación
							</div>
						</div>
					</div>
				</div>

				<!-- Columna derecha: círculo orbital -->
				<div
					class="hero-orbit-container relative flex justify-center items-center animate-zoom-in animate-delay-500 animate-duration-slow"
				>
					<div
						class="relative w-[300px] h-[300px] md:w-[450px] md:h-[450px]"
					>
						<!-- Anillos decorativos -->
						<div
							class="absolute inset-0 rounded-full border border-sky-200/80"
						></div>
						<div
							class="absolute inset-6 rounded-full border border-sky-200/50"
						></div>
						<div
							class="absolute inset-14 rounded-full border border-sky-100"
						></div>

						<!-- Centro: ícono que rota cada 4s (todo el bloque clickeable) -->
						<div
							class="absolute inset-0 flex flex-col items-center justify-center pointer-events-none z-10"
						>
							<button
								id="hero-center-btn"
								type="button"
								class="pointer-events-auto cursor-pointer flex flex-col items-center transition-transform duration-200 hover:scale-105 active:scale-95"
								data-service-slug="mercado"
								aria-label="Pedir Mercado"
							>
								<img
									id="hero-center-img"
									src="/shop.avif"
									alt="Mercado"
									class="w-32 h-32 md:w-44 md:h-44 object-contain drop-shadow-2xl transition-opacity duration-500"
								/>
								<span
									id="hero-center-chip"
									class="mt-2 px-4 py-1 bg-white rounded-full shadow-md border border-sky-100 text-sm md:text-base font-bold text-gray-800 transition-opacity duration-500"
								>
									Mercado
								</span>
							</button>
						</div>

						<!-- Anillo orbital: 5 íconos clickeables -->
						<div class="hero-orbit-ring absolute inset-0 z-[5]">
							{
								ORBITAL.map((s, i) => (
									<button
										type="button"
										data-service-slug={s.slug}
										class="hero-orbit-btn group"
										style={`--orbit-angle: ${(360 / ORBITAL.length) * i}deg;`}
										aria-label={`Pedir ${s.titulo ?? s.servicio}`}
									>
										<img
											src={s.imagen}
											alt={s.alt || s.servicio}
											loading="lazy"
											class="hero-orbit-img w-14 h-14 md:w-20 md:h-20 object-contain drop-shadow-xl pointer-events-none"
										/>
									</button>
								))
							}
						</div>

						<!-- Badge "30 min promedio" -->
						<div
							class="absolute bottom-1 right-[70px] md:bottom-3 md:right-3 z-20 bg-green-500 text-white text-xs md:text-sm font-bold px-3 py-2 rounded-full  flex items-center gap-1.5 animate-bounce animate-duration-slower"
						>
							<span>⚡</span>
							30 min promedio
						</div>
					</div>
				</div>
			</div>
		</section>
		<br id="servicios" class="" />
		<div class="flex flex-col justify-center mt-9 items-center w-full px-3">
			<div class="text-center mb-8 md:mb-10 px-4 max-w-[1100px] w-full">
				<p class="text-sm font-semibold uppercase tracking-widest text-[#2563eb]">
					Nuestros servicios
				</p>
				<h2 class="mt-2 text-4xl md:text-5xl font-extrabold text-[#0b0e14]">
					¿Qué te traemos hoy?
				</h2>
				<p class="mt-3 text-gray-500">
					Tocá un rubro y completá tu pedido en segundos.
				</p>
			</div>
			<div
				class="grid grid-cols-3 md:grid-cols-4 gap-4 sm:gap-5 w-full max-w-[1100px]"
			>
				{SERVICIOS.map((s, i) => <ServiceCard {...s} index={i} />)}
			</div>
		</div>
		<br id="informacion" class="" />
		<div class="text-center my-8 md:my-12 px-4">
			<p class="text-sm font-semibold uppercase tracking-widest text-[#2563eb]">
				Información
			</p>
			<h2 class="mt-2 text-3xl md:text-5xl font-extrabold text-[#0b0e14]">
				Todo lo que necesitás saber
			</h2>
			<p class="mt-3 text-gray-500 max-w-xl mx-auto">
				Cómo trabajamos, por qué elegirnos y nuestra forma de cuidar cada pedido.
			</p>
		</div>
		<Carouselchill />

		<section class="max-w-4xl mx-auto px-4 mt-4">
			<div class="grid gap-3 grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 auto-rows-[250px] lg:auto-rows-[230px]">

				<!-- Quiénes Somos -->
				<article class="bento-card group relative overflow-hidden rounded-2xl p-4 bg-gradient-to-br from-emerald-50 via-emerald-100/60 to-teal-100 border border-emerald-200/60 shadow-md flex flex-col transition-all duration-300 ease-out hover:-translate-y-1 hover:shadow-xl hover:border-emerald-300">
					<div class="absolute -top-8 -right-8 w-28 h-28 rounded-full bg-emerald-300/40 blur-2xl pointer-events-none transition-transform duration-700 group-hover:scale-125"></div>
					<div class="relative flex items-center gap-2 mb-2">
						<div class="shrink-0 w-10 h-10 rounded-xl bg-emerald-500 text-white text-lg flex items-center justify-center shadow-md shadow-emerald-500/30 transition-transform duration-300 group-hover:scale-110 group-hover:-rotate-6">
							👤
						</div>
						<h3 class="text-lg font-extrabold text-emerald-900">Quiénes Somos</h3>
					</div>
					<p class="relative text-gray-700 text-sm overflow-y-auto pr-1 leading-relaxed">
						En <b>Mandados Ahora</b> brindamos un servicio local de compras y envíos en San Miguel del Monte, pensado para ofrecer comodidad, rapidez, una atención amable y directa. Nuestro objetivo es que recibas tus productos.
					</p>
				</article>

				<!-- Por Qué Elegirnos -->
				<article class="bento-card group relative overflow-hidden rounded-2xl p-4 bg-gradient-to-br from-cyan-50 via-sky-100/60 to-cyan-100 border border-cyan-200/60 shadow-md flex flex-col transition-all duration-300 ease-out hover:-translate-y-1 hover:shadow-xl hover:border-cyan-300">
					<div class="absolute -bottom-8 -left-8 w-28 h-28 rounded-full bg-cyan-300/40 blur-2xl pointer-events-none transition-transform duration-700 group-hover:scale-125"></div>
					<div class="relative flex items-center gap-2 mb-2">
						<div class="shrink-0 w-10 h-10 rounded-xl bg-cyan-500 text-white text-lg flex items-center justify-center shadow-md shadow-cyan-500/30 transition-transform duration-300 group-hover:scale-110 group-hover:rotate-6">
							✅
						</div>
						<h3 class="text-lg font-extrabold text-cyan-900">Por Qué Elegirnos</h3>
					</div>
					<ul class="relative text-gray-700 text-sm overflow-y-auto pr-1 space-y-1">
						<li class="flex items-start gap-2"><span class="text-cyan-600 mt-0.5">✓</span><span>Servicio 100% local, confiable y cercano.</span></li>
						<li class="flex items-start gap-2"><span class="text-cyan-600 mt-0.5">✓</span><span>Entregas rápidas y responsables.</span></li>
						<li class="flex items-start gap-2"><span class="text-cyan-600 mt-0.5">✓</span><span>Atención personalizada en cada pedido.</span></li>
						<li class="flex items-start gap-2"><span class="text-cyan-600 mt-0.5">✓</span><span>Comunicación directa, sin intermediarios.</span></li>
						<li class="flex items-start gap-2"><span class="text-cyan-600 mt-0.5">✓</span><span>Cuidado total de los productos hasta tu puerta.</span></li>
						<li class="flex items-start gap-2"><span class="text-cyan-600 mt-0.5">✓</span><span>Transparencia en precios, tiempos y condiciones.</span></li>
					</ul>
				</article>

				<!-- Cómo Trabajamos -->
				<article class="bento-card group relative overflow-hidden rounded-2xl p-4 bg-gradient-to-br from-blue-50 via-sky-100/70 to-blue-200 border border-blue-200/60 shadow-md flex flex-col lg:col-span-1 sm:row-span-2 md:row-span-1 transition-all duration-300 ease-out hover:-translate-y-1 hover:shadow-xl hover:border-blue-300">
					<div class="absolute -top-10 -right-10 w-32 h-32 rounded-full bg-blue-400/30 blur-2xl pointer-events-none transition-transform duration-700 group-hover:scale-125"></div>
					<div class="relative flex items-center gap-2 mb-2">
						<div class="shrink-0 w-10 h-10 rounded-xl bg-blue-600 text-white text-lg flex items-center justify-center shadow-md shadow-blue-600/30 transition-transform duration-300 group-hover:scale-110 group-hover:-rotate-12">
							🛵
						</div>
						<h3 class="text-lg font-extrabold text-blue-900">Cómo Trabajamos</h3>
					</div>
					<ol class="relative text-gray-700 text-sm overflow-y-auto pr-1 space-y-1.5">
						{[
							"Nos enviás tu pedido por mensaje o formulario.",
							"Retiramos los productos del comercio correspondiente.",
							"Verificamos estado y embalaje.",
							"Entrega rápida y segura en tu domicilio.",
							"Te mantenemos informado durante todo el proceso.",
							"Entregamos el recibo del comercio.",
						].map((step, i) => (
							<li class="flex items-start gap-2">
								<span class="shrink-0 w-5 h-5 rounded-full bg-white text-blue-700 text-[11px] font-bold flex items-center justify-center border border-blue-200 shadow-sm">
									{i + 1}
								</span>
								<span class="leading-snug pt-0.5">{step}</span>
							</li>
						))}
					</ol>
				</article>

				<!-- Medios de Pago -->
				<article class="bento-card group relative overflow-hidden rounded-2xl p-4 bg-gradient-to-br from-amber-50 via-yellow-100/70 to-amber-100 border border-amber-200/60 shadow-md flex flex-col col-span-1 transition-all duration-300 ease-out hover:-translate-y-1 hover:shadow-xl hover:border-amber-300">
					<div class="absolute -top-8 -right-8 w-28 h-28 rounded-full bg-amber-300/40 blur-2xl pointer-events-none transition-transform duration-700 group-hover:scale-125"></div>
					<div class="relative flex items-center gap-2 mb-2">
						<div class="shrink-0 w-10 h-10 rounded-xl bg-amber-500 text-white text-lg flex items-center justify-center shadow-md shadow-amber-500/30 transition-transform duration-300 group-hover:scale-110 group-hover:rotate-6">
							💵
						</div>
						<h3 class="text-lg font-extrabold text-amber-900">Medios de Pago</h3>
					</div>
					<ul class="relative text-gray-700 text-sm overflow-y-auto pr-1 space-y-1">
						<li class="flex items-start gap-2"><span class="text-amber-700 mt-0.5">●</span><span>Pago en efectivo al recibir el pedido.</span></li>
						<li class="flex items-start gap-2"><span class="text-amber-700 mt-0.5">●</span><span>Transferencia bancaria (CBU/Alias).</span></li>
					</ul>
				</article>

				<!-- Seguridad -->
				<article class="bento-card group relative overflow-hidden rounded-2xl p-4 bg-gradient-to-br from-indigo-50 via-violet-100/60 to-indigo-100 border border-indigo-200/60 shadow-md flex flex-col md:col-span-2 transition-all duration-300 ease-out hover:-translate-y-1 hover:shadow-xl hover:border-indigo-300">
					<div class="absolute -bottom-10 -right-10 w-32 h-32 rounded-full bg-indigo-300/40 blur-2xl pointer-events-none transition-transform duration-700 group-hover:scale-125"></div>
					<div class="relative flex items-center gap-2 mb-2">
						<div class="shrink-0 w-10 h-10 rounded-xl bg-indigo-600 text-white text-lg flex items-center justify-center shadow-md shadow-indigo-600/30 transition-transform duration-300 group-hover:scale-110 group-hover:-rotate-6">
							🛡️
						</div>
						<h3 class="text-lg font-extrabold text-indigo-900">Compromiso con la Seguridad</h3>
					</div>
					<ul class="relative text-gray-700 text-sm overflow-y-auto pr-1 space-y-1">
						<li class="flex items-start gap-2"><span class="text-indigo-600 mt-0.5">●</span><span>Protección de datos personales y de contacto.</span></li>
						<li class="flex items-start gap-2"><span class="text-indigo-600 mt-0.5">●</span><span>Manejamos cada pedido con responsabilidad.</span></li>
						<li class="flex items-start gap-2"><span class="text-indigo-600 mt-0.5">●</span><span>Verificamos productos antes de entregarlos.</span></li>
						<li class="flex items-start gap-2"><span class="text-indigo-600 mt-0.5">●</span><span>Te informamos cada paso del proceso.</span></li>
						<li class="flex items-start gap-2"><span class="text-indigo-600 mt-0.5">●</span><span>Solo personal autorizado realiza entregas.</span></li>
					</ul>
