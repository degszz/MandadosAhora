  @keyframes hero-card-float {
    from { transform: translateY(0); }
    to   { transform: translateY(-12px); }
  }

  /* ── Orbit ring (estático, sin rotación) ── */
  .hero-orbit-ring {
    transform-origin: center;
  }

  /* ── Orbit buttons (posición fija en el anillo) ── */
  .hero-orbit-btn {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 76px;
    height: 96px;
    margin: -48px 0 0 -38px;
    border: none;
    background: transparent;
    padding: 0;
    cursor: pointer;
    pointer-events: auto;
    outline: none;
    -webkit-tap-highlight-color: transparent;
    transform: rotate(var(--orbit-angle)) translateY(-135px)
      rotate(calc(var(--orbit-angle) * -1));
  }
  @media (min-width: 768px) {
    .hero-orbit-btn {
      width: 92px;
      height: 110px;
      margin: -55px 0 0 -46px;
      transform: rotate(var(--orbit-angle)) translateY(-200px)
        rotate(calc(var(--orbit-angle) * -1));
    }
  }

  /* ── Card wrapper: solo flota (sin rotación) ── */
