  }
  @media (min-width: 768px) {
    .orbit-card-img { width: 56px; height: 56px; }
  }
  .hero-orbit-btn:hover .orbit-card-img {
    filter: drop-shadow(0 4px 14px rgba(37,99,235,0.45));
  }

  /* ── Label de la card ── */
  .orbit-card-label {
    font-size: 8px;
    font-weight: 700;
    color: #374151;
    margin-top: 5px;
    text-align: center;
