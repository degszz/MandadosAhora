		<Footer />
	</body>
	<AudioRecorder client:load />
</Layout>

<script>
  const reveal = (el) => {
    el.classList.remove("opacity-0");
    el.classList.add("animate-fade-in-up");
  };

  const els = document.querySelectorAll("[data-reveal]");

  if ("IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            reveal(entry.target);
            io.unobserve(entry.target);
          }
        });
      },
      { rootMargin: "0px 0px -10% 0px", threshold: 0.05 }
    );
    els.forEach((el) => io.observe(el));
  } else {
    els.forEach(reveal);
  }
</script>

<script define:vars={{ cycle: SERVICIOS }}>
  // ── Sistema de ciclado SIN duplicados ──
  // Todas las posiciones (centro + 5 orbitales) comparten un Set de slugs
  // activos para que nunca se repita un servicio visible.

  const centerImg = document.getElementById("hero-center-img");
  const centerChip = document.getElementById("hero-center-chip");
  const centerBtn = document.getElementById("hero-center-btn");
  const orbitBtns = document.querySelectorAll('.hero-orbit-btn');

  if (centerImg && centerChip && centerBtn && cycle.length >= 6) {
    // Estado: qué slug muestra cada slot (0 = centro, 1-5 = orbitales)
    const showing = [
      centerBtn.dataset.serviceSlug,
      ...Array.from(orbitBtns).map(b => b.dataset.serviceSlug)
    ];

    // Elegir un servicio que no esté en ningún slot visible
    function pickUnique(slotIdx) {
      const used = new Set(showing);
      const available = cycle.filter(s => !used.has(s.slug));
      if (available.length === 0) return cycle[Math.floor(Math.random() * cycle.length)];
      return available[Math.floor(Math.random() * available.length)];
    }

    // Aplicar un servicio a un slot con animación
    function applyToSlot(slotIdx, s) {
      showing[slotIdx] = s.slug;

      if (slotIdx === 0) {
        // Centro
        centerImg.style.opacity = "0";
        centerChip.style.opacity = "0";
        setTimeout(() => {
          centerImg.src = s.imagen;
          centerImg.alt = s.alt || s.servicio;
          centerChip.textContent = s.titulo ?? s.servicio;
          centerBtn.dataset.serviceSlug = s.slug;
          centerBtn.setAttribute("aria-label", "Pedir " + (s.titulo ?? s.servicio));
          centerImg.style.opacity = "1";
          centerChip.style.opacity = "1";
        }, 280);
      } else {
        // Orbital
        const btn = orbitBtns[slotIdx - 1];
        if (!btn) return;
        const card = btn.querySelector('.orbit-card');
        const img = btn.querySelector('.orbit-card-img');
        const label = btn.querySelector('.orbit-card-label');
        if (!card || !img || !label) return;

        card.style.opacity = '0';
        card.style.transform = 'scale(0.82)';
        setTimeout(() => {
          img.src = s.imagen;
          img.alt = s.alt || s.servicio;
          label.textContent = s.titulo ?? s.servicio;
          btn.dataset.serviceSlug = s.slug;
          btn.setAttribute('aria-label', 'Pedir ' + (s.titulo ?? s.servicio));
          card.style.opacity = '1';
          card.style.transform = 'scale(1)';
        }, 300);
      }
    }

    // Centro cicla cada 4s
    setInterval(() => {
      applyToSlot(0, pickUnique(0));
    }, 4000);

    // Orbitales ciclan con stagger
    orbitBtns.forEach((_, idx) => {
      const interval = 3200 + idx * 700;
      setTimeout(() => {
        setInterval(() => {
          applyToSlot(idx + 1, pickUnique(idx + 1));
        }, interval);
      }, 2500 + idx * 900);
    });
  }
</script>

<style>
