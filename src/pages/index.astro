  /* ── Card central (glass) ── */
  .orbit-center-card, .hero-orbit-btn:focus, .orbit-center-card:focus {
    outline: none;
    -webkit-tap-highlight-color: transparent;
  }
  .orbit-center-card {
    background: rgba(255, 255, 255, 0.88);
    border-radius: 28px;
