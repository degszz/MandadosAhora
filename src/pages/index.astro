---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
import Carouselchill from "../components/Carouselchill.astro";
import AudioRecorder from "../components/AudioRecorder.jsx";
import ServiceCard from "../components/ServiceCard.astro";
import Footer from "../components/Footer.astro";
import { SERVICIOS } from "../data/servicios.js";

const ORBITAL_SLUGS = ["mercado", "farmacia", "carniceria", "panaderia", "verduleria"];
const ORBITAL = ORBITAL_SLUGS
  .map((slug) => SERVICIOS.find((s) => s.slug === slug))
  .filter(Boolean);
---

<Layout>
	<body class="h-full w-full flex flex-col justify-center items-center">
		<section
			class="hero-section relative w-full overflow-hidden px-4 pt-[85px] pb-10 md:pt-[95px] md:pb-16 lg:pt-[100px] lg:pb-24 -mt-[75px]"
			style="background: linear-gradient(165deg, #c7ddfc 0%, #dbeafe 22%, #eff6ff 52%, #f0f9ff 76%, #f8fafc 100%);"
		>
			<div
				class="max-w-6xl mx-auto grid md:grid-cols-2 gap-10 md:gap-8 items-center"
			>
				<!-- Columna izquierda -->
				<div class="flex flex-col items-center text-center sm:items-start sm:text-left gap-2 md:gap-6">
					<span
						id="hero-status-badge"
						class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white backdrop-blur border border-sky-200/80 text-sky-900 text-xs sm:text-sm font-medium animate-fade-in-down animate-duration-slow"
					>
						<span id="hero-status-dot" class="relative inline-flex w-2 h-2">
							<span
								class="absolute inset-0 rounded-full bg-gray-400"
								id="hero-dot-solid"
							></span>
							<span
								class="absolute inset-0 rounded-full bg-gray-400 opacity-75"
								id="hero-dot-ping"
							></span>
						</span>
						<span id="hero-status-text">San Miguel del Monte</span>
					</span>

					<h1
						class="text-3xl md:text-6xl lg:text-7xl font-extrabold leading-[1.05] tracking-tight animate-fade-in-up animate-delay-200 animate-duration-slow"
						style="font-family: 'Inter', system-ui, sans-serif;"
					>
						<span class="block text-[#0b0e14]"
							>Pedí lo que necesites,</span
						>
						<span class="block text-[#2563eb]">te lo llevamos.</span>
					</h1>

					<p
						class="text-base md:text-lg text-gray-600 max-w-md mx-auto sm:mx-0 animate-fade-in-up animate-delay-400 animate-duration-slow"
					>
						Súper, farmacia, carnicería y mucho más. Hacé tu mandado
						desde casa y te lo llevamos a la puerta.
						<b class="text-gray-800">Sin vueltas.</b>
					</p>

					<div
						class="flex flex-row justify-center sm:justify-start w-full max-w-xs mx-auto sm:mx-0 sm:max-w-md animate-fade-in-up animate-delay-600 animate-duration-slow gap-2"
					>
						<a
							href="#servicios"
							class="inline-flex items-center justify-center gap-2 bg-[#2563eb] hover:bg-[#1d4ed8] text-white font-semibold px-4 py-2.5 rounded-xl shadow-lg shadow-blue-500/30 transition-all duration-200 hover:scale-[1.02] active:scale-95 text-sm"
						>
							<svg
								xmlns="http://www.w3.org/2000/svg"
								width="17"
								height="17"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2.5"
								stroke-linecap="round"
								stroke-linejoin="round"
							>
								<path d="M12 5v14"></path>
								<path d="M5 12h14"></path>
							</svg>
							Empezar pedido
						</a>
						<a
							href="https://wa.me/2271415182"
							target="_blank"
							rel="noopener"
							class="inline-flex items-center justify-center gap-2 bg-white hover:bg-gray-50 border border-gray-300 text-gray-800 font-semibold px-4 py-2.5 rounded-xl shadow transition-all duration-200 hover:scale-[1.02] active:scale-95 text-sm"
						>
							<svg
								xmlns="http://www.w3.org/2000/svg"
								width="17"
								height="17"
								viewBox="0 0 24 24"
								fill="none"
								stroke="#25D366"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
							>
								<path
									stroke="none"
									d="M0 0h24v24H0z"
									fill="none"></path>
								<path
									d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9"
								></path>
								<path
									d="M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1"
								></path>
							</svg>
							WhatsApp
						</a>
					</div>

					<div
						class="grid grid-cols-3 gap-3 md:gap-6 w-full max-w-xs mx-auto sm:mx-0 sm:max-w-md animate-fade-in-up animate-delay-800 animate-duration-slow"
					>
						<div>
							<div
								class="text-2xl md:text-3xl font-extrabold text-[#2563eb]"
							>
								25 min
							</div>
							<div class="text-xs md:text-sm text-gray-500">
								Entrega promedio
							</div>
						</div>
						<div>
							<div
								class="text-2xl md:text-3xl font-extrabold text-[#2563eb]"
							>
								14
							</div>
							<div class="text-xs md:text-sm text-gray-500">
								Rubros
							</div>
						</div>
						<div>
							<div
								class="text-2xl md:text-3xl font-extrabold text-[#2563eb]"
							>
								4.9★
							</div>
							<div class="text-xs md:text-sm text-gray-500">
								Calificación
							</div>
						</div>
					</div>
				</div>

				<!-- Columna derecha: círculo orbital -->
				<div
					class="hero-orbit-container relative flex justify-center items-center animate-zoom-in animate-delay-500 animate-duration-slow"
				>
					<div
						class="relative w-[300px] h-[300px] md:w-[450px] md:h-[450px]"
					>
						<!-- Anillos decorativos -->
						<div class="absolute inset-0 rounded-full border-2 hero-orbit-ring-deco-1" style="border-color:rgba(147,197,253,0.45)"></div>
						<div class="absolute inset-6 rounded-full border hero-orbit-ring-deco-2" style="border-color:rgba(147,197,253,0.28)"></div>
						<div class="absolute inset-14 rounded-full border hero-orbit-ring-deco-3" style="border-color:rgba(147,197,253,0.18)"></div>

						<!-- Centro: ícono que rota cada 4s (todo el bloque clickeable) -->
						<div
							class="absolute inset-0 flex flex-col items-center justify-center pointer-events-none z-10"
						>
							<button
								id="hero-center-btn"
								type="button"
								class="orbit-center-card pointer-events-auto cursor-pointer flex flex-col items-center transition-transform duration-200 hover:scale-105 active:scale-95"
								data-service-slug="mercado"
								aria-label="Pedir Mercado"
							>
								<img
									id="hero-center-img"
									src="/shop.avif"
									alt="Mercado"
									class="w-24 h-24 md:w-36 md:h-36 object-contain drop-shadow-xl transition-opacity duration-500"
								/>
								<span
									id="hero-center-chip"
									class="mt-3 px-4 py-1.5 bg-white/90 rounded-full shadow border border-sky-100 text-sm font-bold text-gray-800 transition-opacity duration-500"
								>
									Mercado
								</span>
							</button>
						</div>

						<!-- Anillo orbital: 5 íconos clickeables -->
						<div class="hero-orbit-ring absolute inset-0 z-[5]">
							{
								ORBITAL.map((s, i) => (
									<button
										type="button"
										data-service-slug={s.slug}
										class="hero-orbit-btn group"
										style={`--orbit-angle: ${(360 / ORBITAL.length) * i}deg;`}
										aria-label={`Pedir ${s.titulo ?? s.servicio}`}
									>
										<div class={`orbit-card-wrapper orbit-fi-${i}`}>
											<div class="orbit-card">
												<img
													src={s.imagen}
													alt={s.alt || s.servicio}
													loading="lazy"
													class="orbit-card-img pointer-events-none"
												/>
												<span class="orbit-card-label">{s.titulo ?? s.servicio}</span>
											</div>
										</div>
									</button>
								))
							}
						</div>

						<!-- Badge "30 min promedio" -->
						<div
							class="absolute bottom-1 right-[70px] md:bottom-3 md:right-3 z-20 bg-green-500 text-white text-xs md:text-sm font-bold px-3 py-2 rounded-full  flex items-center gap-1.5 animate-bounce animate-duration-slower"
						>
							<span>⚡</span>
							25 min promedio
						</div>
					</div>
				</div>
			</div>
		</section>
		<br id="servicios" class="" />

		<!-- Banner 24HS (solo cuando offline) -->
		<div id="offline-24h-banner" style="display:none;max-width:1100px;width:100%;margin:1.5rem auto 0;padding:0 0.75rem">
			<div style="background:linear-gradient(135deg,#1e3a5f 0%,#1e40af 50%,#2563eb 100%);border-radius:1rem;padding:1.25rem 1.5rem;display:flex;align-items:center;gap:1rem;flex-wrap:wrap;justify-content:center;position:relative;overflow:hidden">
				<div style="position:absolute;top:-20px;right:-20px;width:100px;height:100px;border-radius:50%;background:rgba(255,255,255,0.06)"></div>
				<div style="font-size:2rem;flex-shrink:0">🌙</div>
				<div style="flex:1;min-width:200px;text-align:center">
					<p style="color:#fff;font-size:1.1rem;font-weight:800;margin:0;font-family:'Poppins',sans-serif">Estamos fuera de horario</p>
					<p style="color:rgba(255,255,255,0.8);font-size:0.82rem;margin:0.25rem 0 0">Pero el servicio <b style="color:#fbbf24">24 Horas</b> sigue disponible para vos.</p>
				</div>
				<a href="/servicios/24horas" style="background:#fbbf24;color:#1e3a5f;font-weight:700;font-size:0.85rem;padding:0.6rem 1.25rem;border-radius:0.75rem;text-decoration:none;white-space:nowrap;transition:transform .15s;flex-shrink:0">
					Pedir ahora →
				</a>
			</div>
		</div>

		<div class="flex flex-col justify-center mt-9 items-center w-full px-3">
			<div class="text-center mb-8 md:mb-10 px-4 max-w-[1100px] w-full">
				<p class="text-sm font-semibold uppercase tracking-widest text-[#2563eb]">
					Nuestros servicios
				</p>
				<h2 class="mt-2 text-4xl md:text-5xl font-extrabold text-[#0b0e14]">
					¿Qué te traemos hoy?
				</h2>
				<p class="mt-3 text-gray-500">
					Tocá un rubro y completá tu pedido en segundos.
				</p>
			</div>
			<div
				class="grid grid-cols-3 md:grid-cols-4 gap-4 sm:gap-5 w-full max-w-[1100px]"
			>
				{SERVICIOS.map((s, i) => <ServiceCard {...s} index={i} />)}
			</div>
		</div>
		<br id="informacion" class="" />
		<div class="text-center my-8 md:my-12 px-4">
			<p class="text-sm font-semibold uppercase tracking-widest text-[#2563eb]">
				Información
			</p>
			<h2 class="mt-2 text-3xl md:text-5xl font-extrabold text-[#0b0e14]">
				Todo lo que necesitás saber
			</h2>
			<p class="mt-3 text-gray-500 max-w-xl mx-auto">
				Cómo trabajamos, por qué elegirnos y nuestra forma de cuidar cada pedido.
			</p>
		</div>
		<Carouselchill />

		<section class="max-w-4xl mx-auto px-4 mt-4">
			<div class="grid gap-3 grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 auto-rows-[270px]">

				<!-- Quiénes Somos -->
				<article class="bento-card group relative overflow-hidden rounded-2xl p-4 bg-gradient-to-br from-emerald-50 via-emerald-100/60 to-teal-100 border border-emerald-200/60 shadow-md flex flex-col transition-all duration-300 ease-out hover:-translate-y-1 hover:shadow-xl hover:border-emerald-300">
					<div class="absolute -top-8 -right-8 w-28 h-28 rounded-full bg-emerald-300/40 blur-2xl pointer-events-none transition-transform duration-700 group-hover:scale-125"></div>
					<div class="relative flex items-center gap-2 mb-2">
						<div class="shrink-0 w-10 h-10 rounded-xl bg-emerald-500 text-white text-lg flex items-center justify-center shadow-md shadow-emerald-500/30 transition-transform duration-300 group-hover:scale-110 group-hover:-rotate-6">
							👤
						</div>
						<h3 class="text-lg font-extrabold text-emerald-900">Quiénes Somos</h3>
					</div>
					<p class="relative text-gray-700 text-sm overflow-y-auto pr-1 leading-relaxed">
						En <b>Mandados Ahora</b> brindamos un servicio local de compras y envíos en San Miguel del Monte, pensado para ofrecer comodidad, rapidez, una atención amable y directa. Nuestro objetivo es que recibas tus productos.
					</p>
				</article>

				<!-- Por Qué Elegirnos -->
				<article class="bento-card group relative overflow-hidden rounded-2xl p-4 bg-gradient-to-br from-cyan-50 via-sky-100/60 to-cyan-100 border border-cyan-200/60 shadow-md flex flex-col transition-all duration-300 ease-out hover:-translate-y-1 hover:shadow-xl hover:border-cyan-300">
					<div class="absolute -bottom-8 -left-8 w-28 h-28 rounded-full bg-cyan-300/40 blur-2xl pointer-events-none transition-transform duration-700 group-hover:scale-125"></div>
					<div class="relative flex items-center gap-2 mb-2">
						<div class="shrink-0 w-10 h-10 rounded-xl bg-cyan-500 text-white text-lg flex items-center justify-center shadow-md shadow-cyan-500/30 transition-transform duration-300 group-hover:scale-110 group-hover:rotate-6">
							✅
