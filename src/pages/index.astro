---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
import Carouselchill from "../components/Carouselchill.astro";
import AudioRecorder from "../components/AudioRecorder.jsx";
import ServiceCard from "../components/ServiceCard.astro";
import { SERVICIOS } from "../data/servicios.js";

const ORBITAL_SLUGS = ["mercado", "farmacia", "carniceria", "panaderia", "verduleria"];
const ORBITAL = ORBITAL_SLUGS
  .map((slug) => SERVICIOS.find((s) => s.slug === slug))
  .filter(Boolean);
---

<Layout>
	<body class="h-full w-full flex flex-col justify-center items-center">
		<section
			class="hero-section relative w-full overflow-hidden  px-4 py-1 md:py-16 lg:py-20 "
		>
			<div
				class="max-w-6xl mx-auto grid md:grid-cols-2 gap-10 md:gap-8 items-center"
			>
				<!-- Columna izquierda -->
				<div class="flex flex-col items-start gap-2 md:gap-6">
					<span
						class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-sky-100/70 backdrop-blur border border-sky-200/80 text-sky-900 text-xs sm:text-sm font-medium animate-fade-in-down animate-duration-slow"
					>
						<span class="relative inline-flex w-2 h-2">
							<span
								class="absolute inset-0 rounded-full bg-green-500"
							></span>
							<span
								class="absolute inset-0 rounded-full bg-green-500 animate-ping opacity-75"
							></span>
						</span>
						San Miguel del Monte · Online ahora
					</span>

					<h1
						class="text-3xl md:text-6xl lg:text-7xl font-extrabold leading-[1.05] tracking-tight animate-fade-in-up animate-delay-200 animate-duration-slow"
						style="font-family: 'Inter', system-ui, sans-serif;"
					>
						<span class="block text-[#0b0e14]"
							>Pedí lo que necesites,</span
						>
						<span class="block text-[#2563eb]">te lo llevamos.</span>
					</h1>

					<p
						class="text-base md:text-lg text-gray-600 max-w-md animate-fade-in-up animate-delay-400 animate-duration-slow"
					>
						Súper, farmacia, carnicería y mucho más. Hacé tu mandado
						desde casa y te lo llevamos a la puerta.
						<b class="text-gray-800">Sin vueltas.</b>
					</p>

					<div
						class="flex sm:flex-row w-full max-w-md animate-fade-in-up animate-delay-600 animate-duration-slow"
					>
						<a
							href="#servicios"
							class="inline-flex items-center justify-center gap-2 bg-[#2563eb] hover:bg-[#1d4ed8] text-white font-semibold px-3 mx-1 py-2 rounded-xl shadow-lg shadow-blue-500/30 transition-all duration-200 hover:scale-[1.02] active:scale-95"
						>
							<svg
								xmlns="http://www.w3.org/2000/svg"
								width="18"
								height="18"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2.5"
								stroke-linecap="round"
								stroke-linejoin="round"
							>
								<path d="M12 5v14"></path>
								<path d="M5 12h14"></path>
							</svg>
							Empezar pedido
						</a>
						<a
							href="https://wa.me/2271415182"
							target="_blank"
							rel="noopener"
							class="inline-flex items-center justify-center gap-2 bg-white hover:bg-gray-50 border border-gray-300 text-gray-800 font-semibold px-3 py-2 rounded-xl shadow transition-all duration-200 hover:scale-[1.02] active:scale-95"
						>
							<svg
								xmlns="http://www.w3.org/2000/svg"
								width="18"
								height="18"
								viewBox="0 0 24 24"
								fill="none"
								stroke="#25D366"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
							>
								<path
									stroke="none"
									d="M0 0h24v24H0z"
									fill="none"></path>
								<path
									d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9"
								></path>
								<path
									d="M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1"
								></path>
							</svg>
							WhatsApp
						</a>
					</div>

					<div
						class="grid grid-cols-3 gap-3 md:gap-6  w-full max-w-md animate-fade-in-up animate-delay-800 animate-duration-slow"
					>
						<div>
							<div
								class="text-2xl md:text-3xl font-extrabold text-[#2563eb]"
							>
								30 min
							</div>
							<div class="text-xs md:text-sm text-gray-500">
								Entrega promedio
							</div>
						</div>
						<div>
							<div
								class="text-2xl md:text-3xl font-extrabold text-[#2563eb]"
							>
								14
							</div>
							<div class="text-xs md:text-sm text-gray-500">
								Rubros
							</div>
						</div>
						<div>
							<div
								class="text-2xl md:text-3xl font-extrabold text-[#2563eb]"
							>
								4.9★
							</div>
							<div class="text-xs md:text-sm text-gray-500">
								Calificación
							</div>
						</div>
					</div>
				</div>

				<!-- Columna derecha: círculo orbital -->
				<div
					class="hero-orbit-container relative flex justify-center items-center animate-zoom-in animate-delay-500 animate-duration-slow"
				>
					<div
						class="relative w-[300px] h-[300px] md:w-[450px] md:h-[450px]"
					>
						<!-- Anillos decorativos -->
						<div
							class="absolute inset-0 rounded-full border border-sky-200/80"
						></div>
						<div
							class="absolute inset-6 rounded-full border border-sky-200/50"
						></div>
						<div
							class="absolute inset-14 rounded-full border border-sky-100"
						></div>

						<!-- Centro: ícono que rota cada 4s (todo el bloque clickeable) -->
						<div
							class="absolute inset-0 flex flex-col items-center justify-center pointer-events-none z-10"
						>
							<button
								id="hero-center-btn"
								type="button"
								class="pointer-events-auto cursor-pointer flex flex-col items-center transition-transform duration-200 hover:scale-105 active:scale-95"
								data-service-slug="mercado"
								aria-label="Pedir Mercado"
							>
								<img
									id="hero-center-img"
									src="/shop.avif"
									alt="Mercado"
									class="w-32 h-32 md:w-44 md:h-44 object-contain drop-shadow-2xl transition-opacity duration-500"
								/>
								<span
									id="hero-center-chip"
									class="mt-2 px-4 py-1 bg-white rounded-full shadow-md border border-sky-100 text-sm md:text-base font-bold text-gray-800 transition-opacity duration-500"
								>
									Mercado
								</span>
							</button>
						</div>

						<!-- Anillo orbital: 5 íconos clickeables -->
						<div class="hero-orbit-ring absolute inset-0 z-[5]">
							{
								ORBITAL.map((s, i) => (
									<button
										type="button"
										data-service-slug={s.slug}
										class="hero-orbit-btn group"
										style={`--orbit-angle: ${(360 / ORBITAL.length) * i}deg;`}
										aria-label={`Pedir ${s.titulo ?? s.servicio}`}
									>
										<img
											src={s.imagen}
											alt={s.alt || s.servicio}
											loading="lazy"
											class="hero-orbit-img w-14 h-14 md:w-20 md:h-20 object-contain drop-shadow-xl pointer-events-none"
										/>
									</button>
								))
							}
						</div>

						<!-- Badge "30 min promedio" -->
						<div
							class="absolute bottom-1 right-[70px] md:bottom-3 md:right-3 z-20 bg-green-500 text-white text-xs md:text-sm font-bold px-3 py-2 rounded-full  flex items-center gap-1.5 animate-bounce animate-duration-slower"
						>
							<span>⚡</span>
							30 min promedio
						</div>
					</div>
				</div>
			</div>
		</section>
		<br id="servicios" class="" />
		<div class="flex flex-col justify-center mt-9 items-center w-full px-3">
			<h2
				class="text-center md:text-start text-4xl underline mb-4  md:w-full  lg:max-w-[1100px]"
			>
				<b>Servicios:</b>
			</h2>
			<div
				class="grid grid-cols-3 lg:grid-cols-4 gap-3 sm:gap-4 w-full max-w-[1100px] text-md text-serif dark:text-white"
			>
				{SERVICIOS.map((s, i) => <ServiceCard {...s} index={i} />)}

				<!-- Próximo (placeholder) -->
				<div
					data-reveal
					style={`animation-delay: ${Math.min(15 * 70, 700)}ms; animation-fill-mode: both;`}
					class="group relative flex flex-col items-center justify-between
					       w-full aspect-square p-2 sm:p-3
					       rounded-2xl border border-white/60
					       bg-gradient-to-br from-white/95 via-white/80 to-white/60
					       backdrop-blur-sm shadow-md opacity-0
					       cursor-not-allowed"
					aria-disabled="true"
				>
					<div class="absolute inset-0 rounded-2xl opacity-15 bg-gradient-to-br from-[#474d57] via-[#535c67] to-[#616d79]"></div>
					<div class="relative z-10 flex-1 flex items-center justify-center w-full pt-1">
						<img
							src="/burger.avif"
							alt="Próximo"
							class="w-3/4 max-w-[110px] aspect-square object-contain drop-shadow-xl grayscale opacity-70 blur-[1px]"
							loading="lazy"
						/>
					</div>
					<p class="relative z-10 mt-1 text-xs sm:text-sm md:text-base font-bold text-gray-500 text-center px-1 leading-tight">
						Próximamente
					</p>
				</div>
			</div>
		</div>
		<br id="informacion" class="" />
		<h2 class="text-3xl font-bold text-center my-6 mx-4">
			🛒 Información para el Usuario
		</h2>
		<div class="lg:w-full lg:flex lg:justify-center">
			<div class="lg:mx-auto">
				<Carouselchill />
			</div>
		</div>
		<section class="max-w-4xl mx-auto px-4 mt-4">
			<div
				class="grid gap-2 grid-cols-1
           sm:grid-cols-2
           lg:grid-cols-4
           auto-rows-[250px] lg:auto-rows-[230px]"
			>
				<!-- Quiénes Somos -->
				<div
					class="rounded-xl shadow-md p-4 bg-gradient-to-br from-emerald-100 to-teal-50
            flex flex-col transition duration-300 ease-out
            hover:scale-[1.03] hover:shadow-xl hover:saturate-150"
				>
					<h3
						class="text-xl font-semibold mb-2 transition-all duration-300 group-hover:text-emerald-700 hover:text-emerald-700"
					>
						👤 Quiénes Somos
					</h3>
					<p
						class="text-gray-700 text-sm overflow-y-auto pr-1 transition duration-300 hover:text-gray-900"
					>
						En Mandados Ahora brindamos un servicio local de compras
						y envíos en San Miguel del Monte, pensado para ofrecer
						comodidad, rapidez, una atención amable y directa.
						Nuestro objetivo es que recibas tus productos.
					</p>
				</div>

				<!-- Por Qué Elegirnos -->
				<div
					class="rounded-xl shadow-md p-4 bg-gradient-to-br from-cyan-100 to-teal-100
            flex flex-col transition duration-300 ease-out
            hover:scale-[1.03] hover:shadow-xl hover:saturate-150"
				>
					<h3
						class="text-xl font-semibold mb-2 transition-all duration-300 hover:text-cyan-700"
					>
						✅ Por Qué Elegirnos
					</h3>
					<ul
						class="text-gray-700 text-sm overflow-y-auto pr-1 transition duration-300 hover:text-gray-900"
					>
						<li>1 - Servicio 100% local, confiable y cercano.</li>
						<li>2 - Entregas rápidas y responsables.</li>
						<li>3 - Atención personalizada en cada pedido.</li>
						<li>4 - Comunicación directa, sin intermediarios.</li>
						<li>
							5 - Cuidado total de los productos hasta tu puerta.
						</li>
						<li>
							6 - Transparencia en precios, tiempos y condiciones.
						</li>
					</ul>
				</div>

				<!-- Cómo Trabajamos -->
				<div
					class="rounded-xl shadow-md p-4 bg-gradient-to-br from-sky-100 to-cyan-50
            flex flex-col lg:col-span-1 sm:row-span-2 md:row-span-1
            transition duration-300 ease-out
            hover:scale-[1.03] hover:shadow-xl hover:saturate-150"
				>
					<h3
						class="text-xl font-semibold mb-2 transition-all duration-300 hover:text-sky-700"
					>
						🛵 Cómo Trabajamos
					</h3>
					<ul
						class="text-gray-700 text-sm overflow-y-auto pr-1 space-y-1 transition duration-300 hover:text-gray-900"
					>
						<li>
							1 - Nos enviás tu pedido por mensaje o formulario.
						</li>
						<li>
							2 - Retiramos los productos del comercio
							correspondiente.
						</li>
						<li>3 - Verificamos estado y embalaje.</li>
						<li>4 - Entrega rápida y segura en tu domicilio.</li>
						<li>
							5 - Te mantenemos informado durante todo el proceso.
						</li>
						<li>6 - Entregamos el recibo del comercio.</li>
					</ul>
				</div>

				<!-- Medios de Pago -->
				<div
					class="rounded-xl shadow-md p-4 bg-gradient-to-br from-green-100 to-lime-50
            flex flex-col col-span-1 transition duration-300 ease-out
            hover:scale-[1.03] hover:shadow-xl hover:saturate-150"
				>
					<h3
						class="text-xl font-semibold mb-2 transition-all duration-300 hover:text-green-700"
					>
						💵 Medios de Pago
					</h3>
					<ul
						class="text-gray-700 text-sm overflow-y-auto pr-1 space-y-1 transition duration-300 hover:text-gray-900"
					>
						<li>1 - Pago en efectivo al recibir el pedido.</li>
						<li>2 - Transferencia bancaria (CBU/Alias).</li>
					</ul>
				</div>

				<!-- Seguridad -->
				<div
					class="rounded-xl shadow-md p-4 bg-gradient-to-br from-blue-100 to-indigo-50
            flex flex-col md:col-span-2 transition duration-300 ease-out
            hover:scale-[1.03] hover:shadow-xl hover:saturate-150"
				>
					<h3
						class="text-xl font-semibold mb-2 transition-all duration-300 hover:text-indigo-700"
					>
						🛡 Compromiso con la Seguridad
					</h3>
					<ul
						class="space-y-1 text-gray-700 text-sm overflow-y-auto pr-1 transition duration-300 hover:text-gray-900"
					>
						<li>
							1 - Protección de datos personales y de contacto.
						</li>
						<li>2 - Manejamos cada pedido con responsabilidad.</li>
						<li>3 - Verificamos productos antes de entregarlos.</li>
						<li>4 - Te informamos cada paso del proceso.</li>
						<li>5 - Solo personal autorizado realiza entregas.</li>
					</ul>
				</div>

				<!-- Nuestra Misión -->
				<div
					class="rounded-xl shadow-md p-4 bg-gradient-to-br from-teal-100 to-emerald-50
            flex flex-col sm:col-span-2 lg:col-span-2 sm:max-h-[150px]
            transition duration-300 ease-out
            hover:scale-[1.03] hover:shadow-xl hover:saturate-150"
				>
					<h3
						class="text-xl font-semibold mb-2 transition-all duration-300 hover:text-emerald-700"
					>
						⭐ Nuestra Misión
					</h3>
					<p
						class="text-gray-700 text-sm overflow-y-auto pr-1 transition duration-300 hover:text-gray-900"
					>
						Brindar un servicio de mandados que facilite la vida
						diaria de nuestros clientes, ofreciendo rapidez,
						confianza y atención humana. Buscamos apoyar a los
						comercios locales y ser una solución accesible y segura
						para todos los vecinos de San Miguel del Monte.
					</p>
				</div>
			</div>
		</section>
	</body>
	<AudioRecorder client:load />
</Layout>

<script>
  const reveal = (el) => {
    el.classList.remove("opacity-0");
    el.classList.add("animate-fade-in-up");
  };

  const els = document.querySelectorAll("[data-reveal]");

  if ("IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            reveal(entry.target);
            io.unobserve(entry.target);
          }
        });
      },
      { rootMargin: "0px 0px -10% 0px", threshold: 0.05 }
    );
    els.forEach((el) => io.observe(el));
  } else {
    els.forEach(reveal);
  }
</script>

<script define:vars={{ cycle: SERVICIOS }}>
  const centerImg = document.getElementById("hero-center-img");
  const centerChip = document.getElementById("hero-center-chip");
  const centerBtn = document.getElementById("hero-center-btn");

  if (centerImg && centerChip && centerBtn && cycle.length) {
    let i = 0;
    setInterval(() => {
      i = (i + 1) % cycle.length;
      const s = cycle[i];
      centerImg.style.opacity = "0";
      centerChip.style.opacity = "0";
      setTimeout(() => {
        centerImg.src = s.imagen;
        centerImg.alt = s.alt || s.servicio;
        centerChip.textContent = s.titulo ?? s.servicio;
        centerBtn.dataset.serviceSlug = s.slug;
        centerBtn.setAttribute(
          "aria-label",
          `Pedir ${s.titulo ?? s.servicio}`
        );
        centerImg.style.opacity = "1";
        centerChip.style.opacity = "1";
      }, 250);
    }, 4000);
  }

  // Pausar la órbita en mobile cuando se toca el círculo (1.2s)
  // — facilita el tap sobre íconos en movimiento.
  const orbitContainer = document.querySelector(".hero-orbit-container");
  if (orbitContainer) {
    let touchTimer = null;
    orbitContainer.addEventListener(
      "touchstart",
      () => {
        orbitContainer.classList.add("is-touched");
        if (touchTimer) clearTimeout(touchTimer);
        touchTimer = setTimeout(() => {
          orbitContainer.classList.remove("is-touched");
        }, 1200);
      },
      { passive: true }
    );
  }
</script>

<style>
  @keyframes hero-orbit-spin {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes hero-orbit-counter {
    to {
      transform: rotate(-360deg);
    }
  }

  .hero-orbit-ring {
    animation: hero-orbit-spin 40s linear infinite;
    transform-origin: center;
  }

  .hero-orbit-btn {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 56px;
    height: 56px;
    margin: -28px 0 0 -28px;
    border: none;
    background: transparent;
    padding: 0;
    cursor: pointer;
    pointer-events: auto;
    transform: rotate(var(--orbit-angle)) translateY(-130px)
      rotate(calc(var(--orbit-angle) * -1));
  }
  @media (min-width: 768px) {
    .hero-orbit-btn {
      width: 80px;
      height: 80px;
      margin: -40px 0 0 -40px;
      transform: rotate(var(--orbit-angle)) translateY(-195px)
        rotate(calc(var(--orbit-angle) * -1));
    }
  }

  .hero-orbit-img {
    animation: hero-orbit-counter 40s linear infinite;
    transform-origin: center;
    transition: filter 0.2s ease;
  }

  .hero-orbit-container:hover .hero-orbit-ring,
  .hero-orbit-container:hover .hero-orbit-img,
  .hero-orbit-container.is-touched .hero-orbit-ring,
  .hero-orbit-container.is-touched .hero-orbit-img {
    animation-play-state: paused;
  }

  .hero-orbit-btn:hover .hero-orbit-img {
    filter: drop-shadow(0 0 12px rgba(37, 99, 235, 0.55));
  }
</style>
