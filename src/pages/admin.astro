---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
import AdminPanel from "../components/AdminPanel.jsx";
---

<Layout title="Admin · Mandados Ahora">
  <div class="w-full flex justify-center my-8 px-4">
    <div class="w-full max-w-5xl">
      <!-- Vista login -->
      <div id="login-screen" class="hidden">
        <div class="flex justify-center pt-6">
          <div class="bg-white rounded-2xl shadow-xl p-8 w-full max-w-sm border border-gray-100">
            <div class="flex justify-center mb-4">
              <div style="width:56px;height:56px;border-radius:9999px;background:#EBF3FF;display:flex;align-items:center;justify-content:center">
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#377DEC" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                  <path d="M5 13a2 2 0 0 1 2 -2h10a2 2 0 0 1 2 2v6a2 2 0 0 1 -2 2h-10a2 2 0 0 1 -2 -2v-6z"/>
                  <path d="M11 16a1 1 0 1 0 2 0a1 1 0 0 0 -2 0"/>
                  <path d="M8 11v-4a4 4 0 1 1 8 0v4"/>
                </svg>
              </div>
            </div>
            <h1 class="text-xl font-bold text-gray-800 text-center mb-1">Panel de administración</h1>
            <p class="text-sm text-gray-500 text-center mb-5">Iniciá sesión con Google</p>

            <button
              id="google-btn"
              type="button"
              class="w-full flex items-center justify-center gap-3 bg-white border border-gray-300 hover:border-[#377DEC] hover:shadow-md rounded-xl py-2.5 px-4 font-medium text-gray-700 transition-all"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 48 48">
                <path fill="#FFC107" d="M43.611 20.083H42V20H24v8h11.303c-1.649 4.657-6.08 8-11.303 8c-6.627 0-12-5.373-12-12s5.373-12 12-12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4C12.955 4 4 12.955 4 24s8.955 20 20 20s20-8.955 20-20c0-1.341-.138-2.65-.389-3.917z"/>
                <path fill="#FF3D00" d="m6.306 14.691l6.571 4.819C14.655 15.108 18.961 12 24 12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4C16.318 4 9.656 8.337 6.306 14.691z"/>
                <path fill="#4CAF50" d="M24 44c5.166 0 9.86-1.977 13.409-5.192l-6.19-5.238C29.211 35.091 26.715 36 24 36c-5.202 0-9.619-3.317-11.283-7.946l-6.522 5.025C9.505 39.556 16.227 44 24 44z"/>
                <path fill="#1976D2" d="M43.611 20.083H42V20H24v8h11.303a12.04 12.04 0 0 1-4.087 5.571l.003-.002l6.19 5.238C36.971 39.205 44 34 44 24c0-1.341-.138-2.65-.389-3.917z"/>
              </svg>
              <span id="google-btn-label" class="text-sm">Iniciar sesión con Google</span>
            </button>
            <p id="google-err" class="hidden text-sm text-red-700 bg-red-50 border border-red-200 rounded-lg px-3 py-2 mt-3"></p>
          </div>
        </div>
      </div>

      <!-- Vista Google admin (Preact island) -->
      <div id="google-panel" class="hidden">
        <AdminPanel client:only="preact" />
      </div>
    </div>
  </div>
</Layout>

<script>
  import { getSupabase, signInWithGoogle, getMyProfile, signOut } from "../scripts/supabase.js";

  const loginScreen = document.getElementById("login-screen");
  const googlePanel = document.getElementById("google-panel");

  function show(el) {
    loginScreen?.classList.add("hidden");
    googlePanel?.classList.add("hidden");
    el?.classList.remove("hidden");
  }

  // ====================================================================
  // Boot: decidir qué vista mostrar
  // ====================================================================
  (async () => {
    const sb = getSupabase();

    // ¿Sesión Google activa y es admin?
    if (sb) {
      const { data: { session } } = await sb.auth.getSession();
      if (session) {
        const profile = await getMyProfile();
        if (profile?.role === "admin") {
          show(googlePanel);
          return;
        }
        if (profile?.role === "repartidor") {
          window.location.replace(profile.verified ? "/repartidor/panel" : "/repartidor/espera");
          return;
        }
      }
    }

    showLogin();
  })();

  // ====================================================================
  // Login screen
  // ====================================================================
  function showLogin() {
    show(loginScreen);

    const googleBtn = document.getElementById("google-btn");
    const googleLbl = document.getElementById("google-btn-label");
    const googleErr = document.getElementById("google-err");

    googleBtn?.addEventListener("click", async () => {
      googleErr?.classList.add("hidden");
      googleBtn.disabled = true;
      googleLbl.textContent = "Redirigiendo...";
      try {
        await signInWithGoogle("/admin");
      } catch (e) {
        if (googleErr) {
          googleErr.textContent = `⚠️ ${e?.message || "Falló el inicio de sesión con Google"}`;
          googleErr.classList.remove("hidden");
        }
        googleBtn.disabled = false;
        googleLbl.textContent = "Iniciar sesión con Google";
      }
    });
  }
</script>
